{"number":23,"audio":"https://download.quranicaudio.com/qdc/mishari_al_afasy/murattal/23.mp3","verses":[{"n":1,"from":0,"to":6160,"words":[["قَدْ",0,330],["أَفْلَحَ",330,1180],["ٱلْمُؤْمِنُونَ",1180,6125]],"translation":"Certainly will the believers have succeeded:"},{"n":2,"from":6160,"to":14020,"words":[["ٱلَّذِينَ",6115,7385],["هُمْ",7385,7815],["فِى",7815,8145],["صَلَاتِهِمْ",8145,9475],["خَـٰشِعُونَ",9475,13940]],"translation":"They who are during their prayer humbly intent"},{"n":3,"from":14020,"to":21130,"words":[["وَٱلَّذِينَ",13985,15355],["هُمْ",15355,15745],["عَنِ",15745,16185],["ٱللَّغْوِ",16185,17085],["مُعْرِضُونَ",17085,21070]],"translation":"And they who turn away from ill speech"},{"n":4,"from":21130,"to":28780,"words":[["وَٱلَّذِينَ",21105,22455],["هُمْ",22455,22885],["لِلزَّكَوٰةِ",22885,24145],["فَـٰعِلُونَ",24145,28720]],"translation":"And they who are observant of zakāh"},{"n":5,"from":28780,"to":36410,"words":[["وَٱلَّذِينَ",28745,30125],["هُمْ",30125,30465],["لِفُرُوجِهِمْ",30465,32075],["حَـٰفِظُونَ",32075,36320]],"translation":"And they who guard their private parts"},{"n":6,"from":36410,"to":50590,"words":[["إِلَّا",36355,37165],["عَلَىٰٓ",37165,39635],["أَزْوَٰجِهِمْ",39635,41155],["أَوْ",41155,41625],["مَا",41625,42015],["مَلَكَتْ",42015,42905],["أَيْمَـٰنُهُمْ",42905,44335],["فَإِنَّهُمْ",44335,46295],["غَيْرُ",46295,46965],["مَلُومِينَ",46965,50490]],"translation":"Except from their wives or those their right hands possess, for indeed, they will not be blamed -"},{"n":7,"from":50590,"to":62970,"words":[["فَمَنِ",50535,51295],["ٱبْتَغَىٰ",51295,52245],["وَرَآءَ",52245,54775],["ذَٰلِكَ",54775,55625],["فَأُو۟لَـٰٓئِكَ",55625,58594],["هُمُ",58595,59025],["ٱلْعَادُونَ",59025,62870]],"translation":"But whoever seeks beyond that, then those are the transgressors -"},{"n":8,"from":62970,"to":72090,"words":[["وَٱلَّذِينَ",62925,64405],["هُمْ",64405,64795],["لِأَمَـٰنَـٰتِهِمْ",64795,66815],["وَعَهْدِهِمْ",66815,67975],["رَٰعُونَ",67975,72020]],"translation":"And they who are to their trusts and their promises attentive"},{"n":9,"from":72090,"to":80160,"words":[["وَٱلَّذِينَ",72065,73455],["هُمْ",73455,73875],["عَلَىٰ",73875,74485],["صَلَوَٰتِهِمْ",74485,76065],["يُحَافِظُونَ",76065,80080]],"translation":"And they who carefully maintain their prayers -"},{"n":10,"from":80160,"to":87240,"words":[["أُو۟لَـٰٓئِكَ",80105,83064],["هُمُ",83065,83385],["ٱلْوَٰرِثُونَ",83385,87140]],"translation":"Those are the inheritors"},{"n":11,"from":87240,"to":96490,"words":[["ٱلَّذِينَ",87195,88435],["يَرِثُونَ",88435,89445],["ٱلْفِرْدَوْسَ",89445,90785],["هُمْ",90785,91125],["فِيهَا",91125,91965],["خَـٰلِدُونَ",91965,96410]],"translation":"Who will inherit al-Firdaus. They will abide therein eternally."},{"n":12,"from":96490,"to":107770,"words":[["وَلَقَدْ",96455,97255],["خَلَقْنَا",97255,98105],["ٱلْإِنسَـٰنَ",98105,100325],["مِن",100325,101125],["سُلَـٰلَةٍۢ",101125,102635],["مِّن",102635,104615],["طِينٍۢ",104615,107710]],"translation":"And certainly did We create man from an extract of clay."},{"n":13,"from":107770,"to":117170,"words":[["ثُمَّ",107735,108825],["جَعَلْنَـٰهُ",108825,110085],["نُطْفَةًۭ",110085,111815],["فِى",111815,112225],["قَرَارٍۢ",112225,113495],["مَّكِينٍۢ",113495,117080]],"translation":"Then We placed him as a sperm-drop in a firm lodging [i.e., the womb]."},{"n":14,"from":117170,"to":151630,"words":[["ثُمَّ",117105,118825],["خَلَقْنَا",118825,119635],["ٱلنُّطْفَةَ",119635,121165],["عَلَقَةًۭ",121165,122855],["فَخَلَقْنَا",122855,123935],["ٱلْعَلَقَةَ",123935,124975],["مُضْغَةًۭ",124975,126575],["فَخَلَقْنَا",130905,131905],["ٱلْمُضْغَةَ",131905,132965],["عِظَـٰمًۭا",132965,134815],["فَكَسَوْنَا",134815,136065],["ٱلْعِظَـٰمَ",136065,137205],["لَحْمًۭا",137205,138735],["ثُمَّ",138735,140155],["أَنشَأْنَـٰهُ",140155,142355],["خَلْقًا",142355,143255],["ءَاخَرَ ۚ",143255,144795],["فَتَبَارَكَ",144795,146035],["ٱللَّهُ",146035,146885],["أَحْسَنُ",146885,147715],["ٱلْخَـٰلِقِينَ",147715,151520]],"translation":"Then We made the sperm-drop into a clinging clot, and We made the clot into a lump [of flesh], and We made [from] the lump, bones, and We covered the bones with flesh; then We developed him into another creation. So blessed is Allāh, the best of creators."},{"n":15,"from":151630,"to":160380,"words":[["ثُمَّ",151585,152775],["إِنَّكُم",152775,154995],["بَعْدَ",154995,156025],["ذَٰلِكَ",156025,156905],["لَمَيِّتُونَ",156905,160280]],"translation":"Then indeed, after that you are to die."},{"n":16,"from":160380,"to":168240,"words":[["ثُمَّ",160325,161595],["إِنَّكُمْ",161595,163405],["يَوْمَ",163405,163985],["ٱلْقِيَـٰمَةِ",163985,165335],["تُبْعَثُونَ",165335,168160]],"translation":"Then indeed you, on the Day of Resurrection, will be resurrected."},{"n":17,"from":168240,"to":181510,"words":[["وَلَقَدْ",168215,169095],["خَلَقْنَا",169095,170165],["فَوْقَكُمْ",170165,171155],["سَبْعَ",171155,171865],["طَرَآئِقَ",171865,174165],["وَمَا",174165,174685],["كُنَّا",174685,176465],["عَنِ",176465,176855],["ٱلْخَلْقِ",176855,177725],["غَـٰفِلِينَ",177725,181430]],"translation":"And We have created above you seven layered heavens, and never have We been of [Our] creation unaware."},{"n":18,"from":181510,"to":203320,"words":[["وَأَنزَلْنَا",181455,183885],["مِنَ",183885,184235],["ٱلسَّمَآءِ",184235,186635],["مَآءًۢ",186635,189325],["بِقَدَرٍۢ",189326,190165],["فَأَسْكَنَّـٰهُ",190165,193385],["فِى",193385,193635],["ٱلْأَرْضِ ۖ",193635,194945],["وَإِنَّا",194945,196895],["عَلَىٰ",196895,197555],["ذَهَابٍۭ",197555,198595],["بِهِۦ",198595,200065],["لَقَـٰدِرُونَ",200065,203240]],"translation":"And We have sent down rain from the sky in a measured amount and settled it in the earth. And indeed, We are Able to take it away."},{"n":19,"from":203320,"to":226990,"words":[["فَأَنشَأْنَا",203295,205595],["لَكُم",205595,206605],["بِهِۦ",206605,207325],["جَنَّـٰتٍۢ",207325,209255],["مِّن",209255,210285],["نَّخِيلٍۢ",210285,212895],["وَأَعْنَـٰبٍۢ",212895,214135],["لَّكُمْ",218395,219015],["فِيهَا",219015,219775],["فَوَٰكِهُ",219775,220875],["كَثِيرَةٌۭ",220875,222955],["وَمِنْهَا",222955,223925],["تَأْكُلُونَ",223925,226900]],"translation":"And We brought forth for you thereby gardens of palm trees and grapevines in which for you are abundant fruits and from which you eat."},{"n":20,"from":226990,"to":241150,"words":[["وَشَجَرَةًۭ",226925,229055],["تَخْرُجُ",229055,229985],["مِن",229985,231335],["طُورِ",231335,231855],["سَيْنَآءَ",231855,234075],["تَنۢبُتُ",234075,235685],["بِٱلدُّهْنِ",235685,236685],["وَصِبْغٍۢ",236685,237605],["لِّلْـَٔاكِلِينَ",237605,241020]],"translation":"And [We brought forth] a tree issuing from Mount Sinai which produces oil and food [i.e., olives] for those who eat."},{"n":21,"from":241150,"to":260250,"words":[["وَإِنَّ",241085,242595],["لَكُمْ",242595,243215],["فِى",243215,243485],["ٱلْأَنْعَـٰمِ",243485,244755],["لَعِبْرَةًۭ ۖ",244755,246315],["نُّسْقِيكُم",246315,247485],["مِّمَّا",247485,249755],["فِى",249755,250175],["بُطُونِهَا",250175,251525],["وَلَكُمْ",251525,252335],["فِيهَا",252335,253155],["مَنَـٰفِعُ",253155,254225],["كَثِيرَةٌۭ",254225,255895],["وَمِنْهَا",255895,257185],["تَأْكُلُونَ",257185,260150]],"translation":"And indeed, for you in livestock is a lesson. We give you drink from that which is in their bellies, and for you in them are numerous benefits, and from them you eat."},{"n":22,"from":260250,"to":266180,"words":[["وَعَلَيْهَا",260215,261565],["وَعَلَى",261565,262145],["ٱلْفُلْكِ",262145,262995],["تُحْمَلُونَ",262995,266090]],"translation":"And upon them and on ships you are carried."},{"n":23,"from":266180,"to":283000,"words":[["وَلَقَدْ",266125,266965],["أَرْسَلْنَا",266965,268225],["نُوحًا",268225,269045],["إِلَىٰ",269045,269585],["قَوْمِهِۦ",269585,270615],["فَقَالَ",270615,271525],["يَـٰقَوْمِ",271525,272555],["ٱعْبُدُوا۟",272555,273365],["ٱللَّهَ",273365,274055],["مَا",274055,274465],["لَكُم",274465,275185],["مِّنْ",275185,276265],["إِلَـٰهٍ",276265,277245],["غَيْرُهُۥٓ ۖ",277245,278635],["أَفَلَا",278635,279435],["تَتَّقُونَ",279435,282920]],"translation":"And We had certainly sent Noah to his people, and he said, \"O my people, worship Allāh; you have no deity other than Him; then will you not fear Him?\""},{"n":24,"from":283000,"to":321060,"words":[["فَقَالَ",282975,283785],["ٱلْمَلَؤُا۟",283785,284625],["ٱلَّذِينَ",284625,285645],["كَفَرُوا۟",285645,286455],["مِن",286455,287635],["قَوْمِهِۦ",287635,288635],["مَا",288635,288965],["هَـٰذَآ",288965,291175],["إِلَّا",291175,291965],["بَشَرٌۭ",291965,292585],["مِّثْلُكُمْ",292585,294315],["يُرِيدُ",298935,299755],["أَن",299755,300545],["يَتَفَضَّلَ",300545,302075],["عَلَيْكُمْ",302075,303115],["وَلَوْ",303115,303595],["شَآءَ",303595,305445],["ٱللَّهُ",305445,306315],["لَأَنزَلَ",306315,307965],["مَلَـٰٓئِكَةًۭ",307965,310425],["مَّا",310425,311945],["سَمِعْنَا",311945,313075],["بِهَـٰذَا",313075,314105],["فِىٓ",314105,315565],["ءَابَآئِنَا",315565,318065],["ٱلْأَوَّلِينَ",318065,320980]],"translation":"But the eminent among those who disbelieved from his people said, \"This is not but a man like yourselves who wishes to take precedence over you; and if Allāh had willed [to send a messenger], He would have sent down angels. We have not heard of this among our forefathers."},{"n":25,"from":321060,"to":332970,"words":[["إِنْ",321005,321485],["هُوَ",321485,321835],["إِلَّا",321835,322725],["رَجُلٌۢ",322725,324225],["بِهِۦ",324225,324865],["جِنَّةٌۭ",324865,326955],["فَتَرَبَّصُوا۟",326955,328745],["بِهِۦ",328745,329405],["حَتَّىٰ",329405,330235],["حِينٍۢ",330235,332870]],"translation":"He is not but a man possessed with madness, so wait concerning him for a time.\""},{"n":26,"from":332970,"to":340490,"words":[["قَالَ",332925,333585],["رَبِّ",333585,334165],["ٱنصُرْنِى",334165,336205],["بِمَا",336205,336815],["كَذَّبُونِ",336815,340420]],"translation":"[Noah] said, \"My Lord, support me because they have denied me.\""},{"n":27,"from":340490,"to":384430,"words":[["فَأَوْحَيْنَآ",340465,343415],["إِلَيْهِ",343415,344205],["أَنِ",344205,344515],["ٱصْنَعِ",344515,345195],["ٱلْفُلْكَ",345195,346025],["بِأَعْيُنِنَا",346025,347375],["وَوَحْيِنَا",347375,348645],["فَإِذَا",352435,354155],["جَآءَ",354155,356355],["أَمْرُنَا",356355,357305],["وَفَارَ",357305,358115],["ٱلتَّنُّورُ ۙ",358115,359965],["فَٱسْلُكْ",359965,360655],["فِيهَا",360655,361635],["مِن",361635,362595],["كُلٍّۢ",362595,363365],["زَوْجَيْنِ",363365,365025],["ٱثْنَيْنِ",365025,365875],["وَأَهْلَكَ",367965,369025],["إِلَّا",369025,369845],["مَن",369845,370495],["سَبَقَ",370495,371675],["عَلَيْهِ",371675,372475],["ٱلْقَوْلُ",372475,373285],["مِنْهُمْ ۖ",373285,374105],["وَلَا",374105,374675],["تُخَـٰطِبْنِى",374675,376165],["فِى",376165,376385],["ٱلَّذِينَ",376385,377385],["ظَلَمُوٓا۟ ۖ",377385,378375],["إِنَّهُم",378375,380565],["مُّغْرَقُونَ",380565,384350]],"translation":"So We inspired to him, \"Construct the ship under Our observation and Our inspiration, and when Our command comes and the oven overflows, put into it [i.e., the ship] from each [creature] two mates and your family, except him for whom the decree [of destruction] has proceeded. And do not address Me concerning those who have wronged; indeed, they are to be drowned."},{"n":28,"from":384430,"to":399420,"words":[["فَإِذَا",384375,384995],["ٱسْتَوَيْتَ",384995,386105],["أَنتَ",386105,387355],["وَمَن",387355,387835],["مَّعَكَ",387835,389095],["عَلَى",389095,389435],["ٱلْفُلْكِ",389435,390345],["فَقُلِ",390345,390955],["ٱلْحَمْدُ",390955,391785],["لِلَّهِ",391785,392805],["ٱلَّذِى",392805,393655],["نَجَّىٰنَا",393655,394895],["مِنَ",394895,395235],["ٱلْقَوْمِ",395235,396165],["ٱلظَّـٰلِمِينَ",396165,399320]],"translation":"And when you have boarded the ship, you and those with you, then say, 'Praise to Allāh who has saved us from the wrongdoing people.'"},{"n":29,"from":399420,"to":412610,"words":[["وَقُل",399365,399865],["رَّبِّ",399865,400705],["أَنزِلْنِى",400705,402725],["مُنزَلًۭا",402725,404485],["مُّبَارَكًۭا",404485,407045],["وَأَنتَ",407045,408475],["خَيْرُ",408475,409065],["ٱلْمُنزِلِينَ",409065,412510]],"translation":"And say, 'My Lord, let me land at a blessed landing place, and You are the best to accommodate [us].'\""},{"n":30,"from":412610,"to":423740,"words":[["إِنَّ",412565,414025],["فِى",414025,414515],["ذَٰلِكَ",414515,415365],["لَـَٔايَـٰتٍۢ",415365,417685],["وَإِن",417685,418885],["كُنَّا",418885,420335],["لَمُبْتَلِينَ",420335,423640]],"translation":"Indeed in that are signs, and indeed, We are ever testing [Our servants]."},{"n":31,"from":423740,"to":432620,"words":[["ثُمَّ",423685,425075],["أَنشَأْنَا",425075,426925],["مِنۢ",426925,428015],["بَعْدِهِمْ",428015,429055],["قَرْنًا",429055,429845],["ءَاخَرِينَ",429845,432520]],"translation":"Then We produced after them a generation of others."},{"n":32,"from":432620,"to":448080,"words":[["فَأَرْسَلْنَا",432575,434135],["فِيهِمْ",434135,434935],["رَسُولًۭا",434935,435875],["مِّنْهُمْ",435875,437335],["أَنِ",437335,437675],["ٱعْبُدُوا۟",437675,438525],["ٱللَّهَ",438525,439155],["مَا",439155,439585],["لَكُم",439585,440375],["مِّنْ",440375,441425],["إِلَـٰهٍ",441425,442355],["غَيْرُهُۥٓ ۖ",442355,443685],["أَفَلَا",443685,444475],["تَتَّقُونَ",444475,448020]],"translation":"And We sent among them a messenger from themselves, [saying], \"Worship Allāh; you have no deity other than Him; then will you not fear Him?\""},{"n":33,"from":448080,"to":485670,"words":[["وَقَالَ",448055,448845],["ٱلْمَلَأُ",448845,449735],["مِن",449735,450695],["قَوْمِهِ",450695,451475],["ٱلَّذِينَ",451475,452435],["كَفَرُوا۟",452435,453315],["وَكَذَّبُوا۟",453315,454475],["بِلِقَآءِ",454475,457115],["ٱلْـَٔاخِرَةِ",457115,458245],["وَأَتْرَفْنَـٰهُمْ",460645,462425],["فِى",462425,462675],["ٱلْحَيَوٰةِ",462675,463725],["ٱلدُّنْيَا",463725,464745],["مَا",464745,465135],["هَـٰذَآ",465135,467675],["إِلَّا",467675,468455],["بَشَرٌۭ",468455,469065],["مِّثْلُكُمْ",469065,470845],["يَأْكُلُ",475915,476725],["مِمَّا",476725,478055],["تَأْكُلُونَ",478055,479205],["مِنْهُ",479205,480065],["وَيَشْرَبُ",480065,480995],["مِمَّا",480995,482535],["تَشْرَبُونَ",482535,485580]],"translation":"And the eminent among his people who disbelieved and denied the meeting of the Hereafter while We had given them luxury in the worldly life said, \"This is not but a man like yourselves. He eats of that from which you eat and drinks of what you drink."},{"n":34,"from":485670,"to":496560,"words":[["وَلَئِنْ",485605,486415],["أَطَعْتُم",486415,487405],["بَشَرًۭا",487405,488615],["مِّثْلَكُمْ",488615,490155],["إِنَّكُمْ",490155,491945],["إِذًۭا",491945,492355],["لَّخَـٰسِرُونَ",492355,496450]],"translation":"And if you should obey a man like yourselves, indeed, you would then be losers."},{"n":35,"from":496560,"to":510430,"words":[["أَيَعِدُكُمْ",496515,497795],["أَنَّكُمْ",497795,499315],["إِذَا",499315,499955],["مِتُّمْ",499955,500765],["وَكُنتُمْ",500765,502525],["تُرَابًۭا",502525,504035],["وَعِظَـٰمًا",504035,505215],["أَنَّكُم",505215,506745],["مُّخْرَجُونَ",506745,510360]],"translation":"Does he promise you that when you have died and become dust and bones that you will be brought forth [once more]?"},{"n":36,"from":510430,"to":516780,"words":[["۞ هَيْهَاتَ",510405,511625],["هَيْهَاتَ",511625,512555],["لِمَا",512555,513215],["تُوعَدُونَ",513215,516690]],"translation":"How far, how far, is that which you are promised."},{"n":37,"from":516780,"to":527150,"words":[["إِنْ",516715,517145],["هِىَ",517145,517565],["إِلَّا",517565,518325],["حَيَاتُنَا",518325,519425],["ٱلدُّنْيَا",519425,520445],["نَمُوتُ",520445,521345],["وَنَحْيَا",521345,522285],["وَمَا",522285,522935],["نَحْنُ",522935,523545],["بِمَبْعُوثِينَ",523545,527060]],"translation":"It [i.e., life] is not but our worldly life - we die and live, but we will not be resurrected."},{"n":38,"from":527150,"to":537860,"words":[["إِنْ",527125,527605],["هُوَ",527605,527905],["إِلَّا",527905,528735],["رَجُلٌ",528735,529405],["ٱفْتَرَىٰ",529405,530335],["عَلَى",530335,530695],["ٱللَّهِ",530695,531505],["كَذِبًۭا",531505,533005],["وَمَا",533005,533545],["نَحْنُ",533545,534125],["لَهُۥ",534125,534705],["بِمُؤْمِنِينَ",534705,537810]],"translation":"He is not but a man who has invented a lie about Allāh, and we will not believe him.\""},{"n":39,"from":537860,"to":544630,"words":[["قَالَ",537835,538595],["رَبِّ",538595,539135],["ٱنصُرْنِى",539135,540845],["بِمَا",540845,541455],["كَذَّبُونِ",541455,544580]],"translation":"He said, \"My Lord, support me because they have denied me.\""},{"n":40,"from":544630,"to":552600,"words":[["قَالَ",544605,545265],["عَمَّا",545265,546615],["قَلِيلٍۢ",546615,547695],["لَّيُصْبِحُنَّ",547695,549915],["نَـٰدِمِينَ",549915,552510]],"translation":"[Allāh] said, \"After a little, they will surely become regretful.\""},{"n":41,"from":552600,"to":566210,"words":[["فَأَخَذَتْهُمُ",552535,553875],["ٱلصَّيْحَةُ",553875,554895],["بِٱلْحَقِّ",554895,555925],["فَجَعَلْنَـٰهُمْ",555925,557525],["غُثَآءًۭ ۚ",557525,560975],["فَبُعْدًۭا",560975,562115],["لِّلْقَوْمِ",562115,563295],["ٱلظَّـٰلِمِينَ",563295,566090]],"translation":"So the shriek seized them in truth, and We made them as [plant] stubble. Then away with the wrongdoing people."},{"n":42,"from":566210,"to":574990,"words":[["ثُمَّ",566155,567325],["أَنشَأْنَا",567325,569145],["مِنۢ",569145,570015],["بَعْدِهِمْ",570015,570995],["قُرُونًا",570995,572055],["ءَاخَرِينَ",572055,574900]],"translation":"Then We produced after them other generations."},{"n":43,"from":574990,"to":583740,"words":[["مَا",574955,575495],["تَسْبِقُ",575495,576405],["مِنْ",576405,576775],["أُمَّةٍ",576775,578305],["أَجَلَهَا",578305,579335],["وَمَا",579335,580025],["يَسْتَـْٔخِرُونَ",580025,583660]],"translation":"No nation will precede its time [of termination], nor will they remain [thereafter]."},{"n":44,"from":583740,"to":611770,"words":[["ثُمَّ",583695,584765],["أَرْسَلْنَا",584765,586005],["رُسُلَنَا",586005,587065],["تَتْرَا ۖ",587065,588055],["كُلَّ",588055,589055],["مَا",589055,589365],["جَآءَ",589365,591405],["أُمَّةًۭ",591405,592495],["رَّسُولُهَا",592495,593915],["كَذَّبُوهُ ۚ",593915,596185],["فَأَتْبَعْنَا",596185,597975],["بَعْضَهُم",597975,599865],["بَعْضًۭا",599865,601385],["وَجَعَلْنَـٰهُمْ",601385,602875],["أَحَادِيثَ ۚ",602875,604655],["فَبُعْدًۭا",604655,606995],["لِّقَوْمٍۢ",606995,608135],["لَّا",608135,608625],["يُؤْمِنُونَ",608625,611670]],"translation":"Then We sent Our messengers in succession. Every time there came to a nation its messenger, they denied him, so We made them follow one another [to destruction], and We made them narrations. So away with a people who do not believe."},{"n":45,"from":611770,"to":623630,"words":[["ثُمَّ",611715,613255],["أَرْسَلْنَا",613255,614465],["مُوسَىٰ",614465,615255],["وَأَخَاهُ",615255,616355],["هَـٰرُونَ",616355,617325],["بِـَٔايَـٰتِنَا",617325,618935],["وَسُلْطَـٰنٍۢ",618935,620135],["مُّبِينٍ",620135,623550]],"translation":"Then We sent Moses and his brother Aaron with Our signs and a clear authority"},{"n":46,"from":623630,"to":632350,"words":[["إِلَىٰ",623605,624255],["فِرْعَوْنَ",624255,625315],["وَمَلَإِي۟هِۦ",625315,626415],["فَٱسْتَكْبَرُوا۟",626415,627865],["وَكَانُوا۟",627865,628845],["قَوْمًا",628845,629605],["عَالِينَ",629605,632270]],"translation":"To Pharaoh and his establishment, but they were arrogant and were a haughty people."},{"n":47,"from":632350,"to":642900,"words":[["فَقَالُوٓا۟",632285,634355],["أَنُؤْمِنُ",634355,635305],["لِبَشَرَيْنِ",635305,636545],["مِثْلِنَا",636545,637465],["وَقَوْمُهُمَا",637465,638985],["لَنَا",638985,639525],["عَـٰبِدُونَ",639525,642780]],"translation":"They said, \"Should we believe two men like ourselves while their people are for us in servitude?\""},{"n":48,"from":642900,"to":649250,"words":[["فَكَذَّبُوهُمَا",642845,644685],["فَكَانُوا۟",644685,645705],["مِنَ",645705,646015],["ٱلْمُهْلَكِينَ",646015,649130]],"translation":"So they denied them and were of those destroyed."},{"n":49,"from":649250,"to":657790,"words":[["وَلَقَدْ",649185,649985],["ءَاتَيْنَا",649985,651235],["مُوسَى",651235,651835],["ٱلْكِتَـٰبَ",651835,652885],["لَعَلَّهُمْ",652885,654055],["يَهْتَدُونَ",654055,657700]],"translation":"And We certainly gave Moses the Scripture that perhaps they would be guided."},{"n":50,"from":657790,"to":678350,"words":[["وَجَعَلْنَا",657765,661354],["ٱبْنَ",661355,664045],["مَرْيَمَ",664045,664905],["وَأُمَّهُۥٓ",664905,666425],["ءَايَةًۭ",666425,667025],["وَءَاوَيْنَـٰهُمَآ",667025,670965],["إِلَىٰ",670965,671485],["رَبْوَةٍۢ",671485,673215],["ذَاتِ",673215,673795],["قَرَارٍۢ",673795,675625],["وَمَعِينٍۢ",675625,678290]],"translation":"And We made the son of Mary and his mother a sign and sheltered them within a high ground having level [areas] and flowing water."},{"n":51,"from":678350,"to":693270,"words":[["يَـٰٓأَيُّهَا",678315,681185],["ٱلرُّسُلُ",681185,682065],["كُلُوا۟",682065,682625],["مِنَ",682625,682985],["ٱلطَّيِّبَـٰتِ",682985,684535],["وَٱعْمَلُوا۟",684535,685505],["صَـٰلِحًا ۖ",685505,686775],["إِنِّى",686775,688685],["بِمَا",688685,689275],["تَعْمَلُونَ",689275,690465],["عَلِيمٌۭ",690465,693200]],"translation":"[Allāh said], \"O messengers, eat from the good foods and work righteousness. Indeed I, of what you do, am Knowing."},{"n":52,"from":693270,"to":706930,"words":[["وَإِنَّ",693235,694575],["هَـٰذِهِۦٓ",694575,696755],["أُمَّتُكُمْ",696755,698485],["أُمَّةًۭ",698485,700455],["وَٰحِدَةًۭ",700455,702355],["وَأَنَا۠",702355,702895],["رَبُّكُمْ",702895,703895],["فَٱتَّقُونِ",703895,706870]],"translation":"And indeed this, your religion, is one religion, and I am your Lord, so fear Me.\""},{"n":53,"from":706930,"to":719990,"words":[["فَتَقَطَّعُوٓا۟",706905,709845],["أَمْرَهُم",709845,711325],["بَيْنَهُمْ",711325,712295],["زُبُرًۭا ۖ",712295,713795],["كُلُّ",713795,714275],["حِزْبٍۭ",714275,715565],["بِمَا",715565,716225],["لَدَيْهِمْ",716225,717225],["فَرِحُونَ",717225,719920]],"translation":"But they [i.e., the people] divided their religion among them into portions [i.e., sects] - each faction, in what it has, rejoicing."},{"n":54,"from":719990,"to":726050,"words":[["فَذَرْهُمْ",719945,720945],["فِى",720945,721355],["غَمْرَتِهِمْ",721355,722555],["حَتَّىٰ",722555,723385],["حِينٍ",723385,725970]],"translation":"So leave them in their confusion for a time."},{"n":55,"from":726050,"to":736160,"words":[["أَيَحْسَبُونَ",726015,727375],["أَنَّمَا",727375,728935],["نُمِدُّهُم",728935,730585],["بِهِۦ",730585,731095],["مِن",731095,731345],["مَّالٍۢ",731345,733405],["وَبَنِينَ",733405,736070]],"translation":"Do they think that what We extend to them of wealth and children"},{"n":56,"from":736160,"to":745220,"words":[["نُسَارِعُ",736105,737195],["لَهُمْ",737195,737695],["فِى",737695,738015],["ٱلْخَيْرَٰتِ ۚ",738015,741175],["بَل",741175,741555],["لَّا",741555,741985],["يَشْعُرُونَ",741985,745110]],"translation":"Is [because] We hasten for them good things? Rather, they do not perceive."},{"n":57,"from":745220,"to":754420,"words":[["إِنَّ",745155,746685],["ٱلَّذِينَ",746685,747765],["هُم",747765,748275],["مِّنْ",748275,749055],["خَشْيَةِ",749055,749915],["رَبِّهِم",749915,751165],["مُّشْفِقُونَ",751165,754300]],"translation":"Indeed, they who are apprehensive from fear of their Lord"},{"n":58,"from":754420,"to":761580,"words":[["وَٱلَّذِينَ",754365,755675],["هُم",755675,756395],["بِـَٔايَـٰتِ",756395,757785],["رَبِّهِمْ",757785,758815],["يُؤْمِنُونَ",758815,761470]],"translation":"And they who believe in the signs of their Lord"},{"n":59,"from":761580,"to":768630,"words":[["وَٱلَّذِينَ",761525,762775],["هُم",762775,763955],["بِرَبِّهِمْ",763955,765165],["لَا",765165,765545],["يُشْرِكُونَ",765545,768540]],"translation":"And they who do not associate anything with their Lord"},{"n":60,"from":768630,"to":782190,"words":[["وَٱلَّذِينَ",768595,769685],["يُؤْتُونَ",769685,770705],["مَآ",770705,770965],["ءَاتَوا۟",770965,773525],["وَّقُلُوبُهُمْ",773525,774945],["وَجِلَةٌ",774945,775925],["أَنَّهُمْ",775925,777605],["إِلَىٰ",777605,778075],["رَبِّهِمْ",778075,779235],["رَٰجِعُونَ",779235,782130]],"translation":"And they who give what they give while their hearts are fearful because they will be returning to their Lord -"},{"n":61,"from":782190,"to":792190,"words":[["أُو۟لَـٰٓئِكَ",782165,784745],["يُسَـٰرِعُونَ",784745,786145],["فِى",786145,786385],["ٱلْخَيْرَٰتِ",786385,787675],["وَهُمْ",787675,788175],["لَهَا",788175,788795],["سَـٰبِقُونَ",788795,792120]],"translation":"It is those who hasten to good deeds, and they outstrip [others] therein."},{"n":62,"from":792190,"to":806300,"words":[["وَلَا",792135,792785],["نُكَلِّفُ",792785,793745],["نَفْسًا",793745,794565],["إِلَّا",799055,800115],["وُسْعَهَا ۖ",795385,796465],["وَلَدَيْنَا",796465,798105],["كِتَـٰبٌۭ",798105,799055],["يَنطِقُ",799055,800115],["بِٱلْحَقِّ ۚ",800115,802375],["وَهُمْ",802375,802995],["لَا",802995,803405],["يُظْلَمُونَ",803405,806220]],"translation":"And We charge no soul except [with that within] its capacity, and with Us is a record which speaks with truth; and they will not be wronged."},{"n":63,"from":806300,"to":820170,"words":[["بَلْ",806275,806675],["قُلُوبُهُمْ",806675,807915],["فِى",807915,808355],["غَمْرَةٍۢ",808355,809245],["مِّنْ",809245,810335],["هَـٰذَا",810335,811175],["وَلَهُمْ",811175,811925],["أَعْمَـٰلٌۭ",811925,813135],["مِّن",813135,814855],["دُونِ",814855,815545],["ذَٰلِكَ",815545,816305],["هُمْ",816305,816665],["لَهَا",816665,817345],["عَـٰمِلُونَ",817345,820120]],"translation":"But their hearts are covered with confusion over this, and they have [evil] deeds besides that [i.e., disbelief] which they are doing,"},{"n":64,"from":820170,"to":832420,"words":[["حَتَّىٰٓ",820145,822104],["إِذَآ",822105,824165],["أَخَذْنَا",824165,825235],["مُتْرَفِيهِم",825235,827215],["بِٱلْعَذَابِ",827215,828455],["إِذَا",828455,829005],["هُمْ",829005,829435],["يَجْـَٔرُونَ",829435,832340]],"translation":"Until when We seize their affluent ones with punishment, at once they are crying [to Allāh] for help."},{"n":65,"from":832420,"to":844670,"words":[["لَا",832365,832895],["تَجْـَٔرُوا۟",832895,836185],["ٱلْيَوْمَ ۖ",836185,836355],["إِنَّكُم",836355,838255],["مِّنَّا",838255,840395],["لَا",840395,840785],["تُنصَرُونَ",840785,844570]],"translation":"Do not cry out today. Indeed, by Us you will not be helped."},{"n":66,"from":844670,"to":857940,"words":[["قَدْ",844625,845125],["كَانَتْ",845125,845965],["ءَايَـٰتِى",845965,847215],["تُتْلَىٰ",847215,848075],["عَلَيْكُمْ",848075,849055],["فَكُنتُمْ",849055,850785],["عَلَىٰٓ",850785,852635],["أَعْقَـٰبِكُمْ",852635,854075],["تَنكِصُونَ",854075,857840]],"translation":"My verses had already been recited to you, but you were turning back on your heels."},{"n":67,"from":857940,"to":865360,"words":[["مُسْتَكْبِرِينَ",857885,859475],["بِهِۦ",859475,860105],["سَـٰمِرًۭا",860105,861945],["تَهْجُرُونَ",861945,865280]],"translation":"In arrogance regarding it, conversing by night, speaking evil."},{"n":68,"from":865360,"to":879130,"words":[["أَفَلَمْ",865335,866225],["يَدَّبَّرُوا۟",866225,867415],["ٱلْقَوْلَ",867415,868275],["أَمْ",868275,868605],["جَآءَهُم",868605,870855],["مَّا",870855,872055],["لَمْ",872055,872415],["يَأْتِ",872415,873045],["ءَابَآءَهُمُ",873045,875945],["ٱلْأَوَّلِينَ",875945,879070]],"translation":"Then have they not reflected over the word [i.e., the Qur’ān], or has there come to them that which had not come to their forefathers?"},{"n":69,"from":879130,"to":887020,"words":[["أَمْ",879095,879525],["لَمْ",879525,879955],["يَعْرِفُوا۟",879955,880935],["رَسُولَهُمْ",880935,882055],["فَهُمْ",882055,882605],["لَهُۥ",882605,883185],["مُنكِرُونَ",883185,886870]],"translation":"Or did they not know their Messenger, so they are toward him disacknowledging?"},{"n":70,"from":887020,"to":901750,"words":[["أَمْ",886905,887295],["يَقُولُونَ",887295,888585],["بِهِۦ",888585,889135],["جِنَّةٌۢ ۚ",889135,891425],["بَلْ",891425,891815],["جَآءَهُم",891815,894605],["بِٱلْحَقِّ",894605,895765],["وَأَكْثَرُهُمْ",895765,897095],["لِلْحَقِّ",897095,898235],["كَـٰرِهُونَ",898235,901580]],"translation":"Or do they say, \"In him is madness\"? Rather, he brought them the truth, but most of them, to the truth, are averse."},{"n":71,"from":901750,"to":924480,"words":[["وَلَوِ",901695,902455],["ٱتَّبَعَ",902455,903255],["ٱلْحَقُّ",903255,904035],["أَهْوَآءَهُمْ",904035,906935],["لَفَسَدَتِ",906935,907935],["ٱلسَّمَـٰوَٰتُ",907935,909435],["وَٱلْأَرْضُ",909435,910375],["وَمَن",910375,911805],["فِيهِنَّ ۚ",911805,913725],["بَلْ",913725,914715],["أَتَيْنَـٰهُم",914715,916825],["بِذِكْرِهِمْ",916825,918005],["فَهُمْ",918005,918595],["عَن",918595,919655],["ذِكْرِهِم",919655,920735],["مُّعْرِضُونَ",920735,924400]],"translation":"But if the Truth [i.e., Allāh] had followed their inclinations, the heavens and the earth and whoever is in them would have been ruined. Rather, We have brought them their message, but they, from their message, are turning away."},{"n":72,"from":924480,"to":936390,"words":[["أَمْ",924455,924985],["تَسْـَٔلُهُمْ",924985,926125],["خَرْجًۭا",926125,927675],["فَخَرَاجُ",927675,928815],["رَبِّكَ",928815,929595],["خَيْرٌۭ ۖ",929595,932075],["وَهُوَ",932075,932615],["خَيْرُ",932615,933235],["ٱلرَّٰزِقِينَ",933235,936310]],"translation":"Or do you, [O Muḥammad], ask them for payment? But the reward of your Lord is best, and He is the best of providers."},{"n":73,"from":936390,"to":944910,"words":[["وَإِنَّكَ",936335,937945],["لَتَدْعُوهُمْ",937945,939295],["إِلَىٰ",939295,939785],["صِرَٰطٍۢ",939785,940745],["مُّسْتَقِيمٍۢ",940745,944790]],"translation":"And indeed, you invite them to a straight path."},{"n":74,"from":944910,"to":955050,"words":[["وَإِنَّ",944845,946185],["ٱلَّذِينَ",946185,947105],["لَا",947105,947605],["يُؤْمِنُونَ",947605,948725],["بِٱلْـَٔاخِرَةِ",948725,950165],["عَنِ",950165,950525],["ٱلصِّرَٰطِ",950525,951585],["لَنَـٰكِبُونَ",951585,954930]],"translation":"But indeed, those who do not believe in the Hereafter are deviating from the path."},{"n":75,"from":955050,"to":967950,"words":[["۞ وَلَوْ",954995,955655],["رَحِمْنَـٰهُمْ",955655,957045],["وَكَشَفْنَا",957045,958275],["مَا",958275,958625],["بِهِم",958625,959335],["مِّن",959335,961175],["ضُرٍّۢ",961175,961835],["لَّلَجُّوا۟",961835,962995],["فِى",962995,963385],["طُغْيَـٰنِهِمْ",963385,964865],["يَعْمَهُونَ",964865,967840]],"translation":"And even if We gave them mercy and removed what was upon them of affliction, they would persist in their transgression, wandering blindly."},{"n":76,"from":967950,"to":979260,"words":[["وَلَقَدْ",967885,968815],["أَخَذْنَـٰهُم",968815,970875],["بِٱلْعَذَابِ",970875,972315],["فَمَا",972315,972615],["ٱسْتَكَانُوا۟",972615,973935],["لِرَبِّهِمْ",973935,975195],["وَمَا",975195,975775],["يَتَضَرَّعُونَ",975775,979170]],"translation":"And We had gripped them with suffering [as a warning], but they did not yield to their Lord, nor did they humbly supplicate, [and will continue thus]"},{"n":77,"from":979260,"to":995170,"words":[["حَتَّىٰٓ",979235,981644],["إِذَا",981645,982215],["فَتَحْنَا",982215,983265],["عَلَيْهِم",983265,984465],["بَابًۭا",984465,986745],["ذَا",986745,987075],["عَذَابٍۢ",987075,988435],["شَدِيدٍ",988435,989765],["إِذَا",989765,990295],["هُمْ",990295,990725],["فِيهِ",990725,991375],["مُبْلِسُونَ",991375,995090]],"translation":"Until when We have opened before them a door of severe punishment, immediately they will be therein in despair."},{"n":78,"from":995170,"to":1008390,"words":[["وَهُوَ",995115,995755],["ٱلَّذِىٓ",995755,997885],["أَنشَأَ",997885,999285],["لَكُمُ",999285,999795],["ٱلسَّمْعَ",999795,1000695],["وَٱلْأَبْصَـٰرَ",1000695,1002085],["وَٱلْأَفْـِٔدَةَ ۚ",1002085,1003335],["قَلِيلًۭا",1003335,1004205],["مَّا",1004205,1005285],["تَشْكُرُونَ",1005285,1008310]],"translation":"And it is He who produced for you hearing and vision and hearts [i.e., intellect]; little are you grateful."},{"n":79,"from":1008390,"to":1016440,"words":[["وَهُوَ",1008365,1008965],["ٱلَّذِى",1008965,1009845],["ذَرَأَكُمْ",1009845,1010805],["فِى",1010805,1011065],["ٱلْأَرْضِ",1011065,1011845],["وَإِلَيْهِ",1011845,1012855],["تُحْشَرُونَ",1012855,1016390]],"translation":"And it is He who has multiplied you throughout the earth, and to Him you will be gathered."},{"n":80,"from":1016440,"to":1030650,"words":[["وَهُوَ",1016415,1017005],["ٱلَّذِى",1017005,1017855],["يُحْىِۦ",1017855,1018685],["وَيُمِيتُ",1018685,1019695],["وَلَهُ",1019695,1020245],["ٱخْتِلَـٰفُ",1020245,1021185],["ٱلَّيْلِ",1021185,1021995],["وَٱلنَّهَارِ ۚ",1021995,1025714],["أَفَلَا",1025715,1026925],["تَعْقِلُونَ",1026925,1030600]],"translation":"And it is He who gives life and causes death, and His is the alternation of the night and the day. Then will you not reason?"},{"n":81,"from":1030650,"to":1037570,"words":[["بَلْ",1030625,1030995],["قَالُوا۟",1030995,1031785],["مِثْلَ",1031785,1032425],["مَا",1032425,1032745],["قَالَ",1032745,1033375],["ٱلْأَوَّلُونَ",1033375,1037520]],"translation":"Rather, they say like what the former peoples said."},{"n":82,"from":1037570,"to":1050710,"words":[["قَالُوٓا۟",1037545,1039475],["أَءِذَا",1039475,1040265],["مِتْنَا",1040265,1041105],["وَكُنَّا",1041105,1042705],["تُرَابًۭا",1042705,1044065],["وَعِظَـٰمًا",1044065,1045595],["أَءِنَّا",1045595,1047005],["لَمَبْعُوثُونَ",1047005,1050640]],"translation":"They said, \"When we have died and become dust and bones, are we indeed to be resurrected?"},{"n":83,"from":1050710,"to":1066510,"words":[["لَقَدْ",1050665,1051275],["وُعِدْنَا",1051275,1052345],["نَحْنُ",1052345,1052935],["وَءَابَآؤُنَا",1052935,1055985],["هَـٰذَا",1055985,1056795],["مِن",1056795,1057745],["قَبْلُ",1057745,1058285],["إِنْ",1058285,1058705],["هَـٰذَآ",1058705,1060645],["إِلَّآ",1060645,1062575],["أَسَـٰطِيرُ",1062575,1063765],["ٱلْأَوَّلِينَ",1063765,1066440]],"translation":"We have been promised this, we and our forefathers, before; this is not but legends of the former peoples.\""},{"n":84,"from":1066510,"to":1077560,"words":[["قُل",1066475,1066975],["لِّمَنِ",1066975,1067645],["ٱلْأَرْضُ",1067645,1068505],["وَمَن",1068505,1069755],["فِيهَآ",1069755,1072345],["إِن",1072345,1073165],["كُنتُمْ",1073165,1074745],["تَعْلَمُونَ",1074745,1077470]],"translation":"Say, [O Muḥammad], \"To whom belongs the earth and whoever is in it, if you should know?\""},{"n":85,"from":1077560,"to":1086390,"words":[["سَيَقُولُونَ",1077505,1078945],["لِلَّهِ ۚ",1078945,1081915],["قُلْ",1081915,1082255],["أَفَلَا",1082255,1083045],["تَذَكَّرُونَ",1083045,1086270]],"translation":"They will say, \"To Allāh.\" Say, \"Then will you not remember?\""},{"n":86,"from":1086390,"to":1094250,"words":[["قُلْ",1086325,1086685],["مَن",1086685,1086855],["رَّبُّ",1086855,1087645],["ٱلسَّمَـٰوَٰتِ",1087645,1089085],["ٱلسَّبْعِ",1089085,1089875],["وَرَبُّ",1089875,1090615],["ٱلْعَرْشِ",1090615,1091475],["ٱلْعَظِيمِ",1091475,1094150]],"translation":"Say, \"Who is Lord of the seven heavens and Lord of the Great Throne?\""},{"n":87,"from":1094250,"to":1102820,"words":[["سَيَقُولُونَ",1094215,1095595],["لِلَّهِ ۚ",1095595,1098275],["قُلْ",1098275,1098605],["أَفَلَا",1098605,1099415],["تَتَّقُونَ",1099415,1102720]],"translation":"They will say, \"[They belong] to Allāh.\" Say, \"Then will you not fear Him?\""},{"n":88,"from":1102820,"to":1117110,"words":[["قُلْ",1102755,1103125],["مَنۢ",1103125,1103985],["بِيَدِهِۦ",1103985,1105065],["مَلَكُوتُ",1105065,1106125],["كُلِّ",1106125,1106695],["شَىْءٍۢ",1106695,1108135],["وَهُوَ",1108135,1108615],["يُجِيرُ",1108615,1109535],["وَلَا",1109535,1110035],["يُجَارُ",1110035,1110935],["عَلَيْهِ",1110935,1111765],["إِن",1111765,1112845],["كُنتُمْ",1112845,1114255],["تَعْلَمُونَ",1114255,1116980]],"translation":"Say, \"In whose hand is the realm of all things - and He protects while none can protect against Him - if you should know?\""},{"n":89,"from":1117110,"to":1126460,"words":[["سَيَقُولُونَ",1117045,1118445],["لِلَّهِ ۚ",1118445,1121305],["قُلْ",1121305,1121575],["فَأَنَّىٰ",1121575,1123225],["تُسْحَرُونَ",1123225,1126340]],"translation":"They will say, \"[All belongs] to Allāh.\" Say, \"Then how are you deluded?\""},{"n":90,"from":1126460,"to":1134820,"words":[["بَلْ",1126405,1126775],["أَتَيْنَـٰهُم",1126775,1128755],["بِٱلْحَقِّ",1128755,1129685],["وَإِنَّهُمْ",1129685,1131335],["لَكَـٰذِبُونَ",1131335,1134710]],"translation":"Rather, We have brought them the truth, and indeed they are liars."},{"n":91,"from":1134820,"to":1157650,"words":[["مَا",1134765,1134965],["ٱتَّخَذَ",1134965,1135735],["ٱللَّهُ",1135735,1136605],["مِن",1136605,1136935],["وَلَدٍۢ",1136935,1139025],["وَمَا",1139025,1139505],["كَانَ",1139505,1140155],["مَعَهُۥ",1140155,1140915],["مِنْ",1140915,1141345],["إِلَـٰهٍ ۚ",1141345,1143325],["إِذًۭا",1143325,1144155],["لَّذَهَبَ",1144155,1145135],["كُلُّ",1145135,1145705],["إِلَـٰهٍۭ",1145705,1147095],["بِمَا",1147095,1147715],["خَلَقَ",1147715,1148405],["وَلَعَلَا",1148405,1149305],["بَعْضُهُمْ",1149305,1150255],["عَلَىٰ",1150255,1150925],["بَعْضٍۢ ۚ",1150925,1151585],["سُبْحَـٰنَ",1151585,1152855],["ٱللَّهِ",1152855,1153715],["عَمَّا",1153715,1154995],["يَصِفُونَ",1154995,1157540]],"translation":"Allāh has not taken any son, nor has there ever been with Him any deity. [If there had been], then each deity would have taken what it created, and some of them would have [sought to] overcome others. Exalted is Allāh above what they describe [concerning Him]."},{"n":92,"from":1157650,"to":1166820,"words":[["عَـٰلِمِ",1157595,1158435],["ٱلْغَيْبِ",1158435,1159305],["وَٱلشَّهَـٰدَةِ",1159305,1160735],["فَتَعَـٰلَىٰ",1160735,1161825],["عَمَّا",1161825,1163455],["يُشْرِكُونَ",1163455,1166740]],"translation":"[He is] Knower of the unseen and the witnessed, so high is He above what they associate [with Him]."},{"n":93,"from":1166820,"to":1174940,"words":[["قُل",1166795,1167035],["رَّبِّ",1167035,1167795],["إِمَّا",1167795,1169195],["تُرِيَنِّى",1169195,1171265],["مَا",1171265,1171695],["يُوعَدُونَ",1171695,1174890]],"translation":"Say, [O Muḥammad], \"My Lord, if You should show me that which they are promised,"},{"n":94,"from":1174940,"to":1182180,"words":[["رَبِّ",1174905,1175615],["فَلَا",1175615,1176215],["تَجْعَلْنِى",1176215,1177435],["فِى",1177435,1177645],["ٱلْقَوْمِ",1177645,1178535],["ٱلظَّـٰلِمِينَ",1178535,1182090]],"translation":"My Lord, then do not place me among the wrongdoing people.\""},{"n":95,"from":1182180,"to":1191820,"words":[["وَإِنَّا",1182125,1183725],["عَلَىٰٓ",1183725,1185565],["أَن",1185565,1186095],["نُّرِيَكَ",1186095,1187255],["مَا",1187255,1187675],["نَعِدُهُمْ",1187675,1188625],["لَقَـٰدِرُونَ",1188625,1191740]],"translation":"And indeed, We are Able to show you what We have promised them."},{"n":96,"from":1191820,"to":1200570,"words":[["ٱدْفَعْ",1191795,1192605],["بِٱلَّتِى",1192605,1193625],["هِىَ",1193625,1194025],["أَحْسَنُ",1194025,1194825],["ٱلسَّيِّئَةَ ۚ",1194825,1196075],["نَحْنُ",1196075,1196615],["أَعْلَمُ",1196615,1197445],["بِمَا",1197445,1197985],["يَصِفُونَ",1197985,1200520]],"translation":"Repel, by [means of] what is best, [their] evil. We are most knowing of what they describe."},{"n":97,"from":1200570,"to":1207750,"words":[["وَقُل",1200545,1201005],["رَّبِّ",1201005,1201895],["أَعُوذُ",1201895,1202705],["بِكَ",1202705,1203135],["مِنْ",1203135,1203465],["هَمَزَٰتِ",1203465,1204535],["ٱلشَّيَـٰطِينِ",1204535,1207680]],"translation":"And say, \"My Lord, I seek refuge in You from the incitements of the devils,"},{"n":98,"from":1207750,"to":1213890,"words":[["وَأَعُوذُ",1207705,1208745],["بِكَ",1208745,1209215],["رَبِّ",1209215,1209805],["أَن",1209805,1209995],["يَحْضُرُونِ",1209995,1213780]],"translation":"And I seek refuge in You, my Lord, lest they be present with me.\""},{"n":99,"from":1213890,"to":1225170,"words":[["حَتَّىٰٓ",1213825,1216125],["إِذَا",1216125,1216675],["جَآءَ",1216675,1218825],["أَحَدَهُمُ",1218825,1219745],["ٱلْمَوْتُ",1219745,1220655],["قَالَ",1220655,1221185],["رَبِّ",1221185,1221815],["ٱرْجِعُونِ",1221815,1225070]],"translation":"[For such is the state of the disbelievers] until, when death comes to one of them, he says, \"My Lord, send me back"},{"n":100,"from":1225170,"to":1250350,"words":[["لَعَلِّىٓ",1225125,1227355],["أَعْمَلُ",1227355,1228135],["صَـٰلِحًۭا",1228135,1229775],["فِيمَا",1229775,1230645],["تَرَكْتُ ۚ",1230645,1231975],["كَلَّآ ۚ",1231975,1232875],["إِنَّهَا",1232875,1234785],["كَلِمَةٌ",1234785,1235885],["هُوَ",1235885,1236325],["قَآئِلُهَا ۖ",1236325,1239475],["وَمِن",1239475,1240625],["وَرَآئِهِم",1240625,1244625],["بَرْزَخٌ",1244625,1245655],["إِلَىٰ",1245655,1246225],["يَوْمِ",1246225,1246845],["يُبْعَثُونَ",1246845,1250280]],"translation":"That I might do righteousness in that which I left behind.\" No! It is only a word he is saying; and behind them is a barrier until the Day they are resurrected."},{"n":101,"from":1250350,"to":1264770,"words":[["فَإِذَا",1250325,1251175],["نُفِخَ",1251175,1251755],["فِى",1251755,1251915],["ٱلصُّورِ",1251915,1252815],["فَلَآ",1252815,1254795],["أَنسَابَ",1254795,1256315],["بَيْنَهُمْ",1256315,1257325],["يَوْمَئِذٍۢ",1257325,1258965],["وَلَا",1258965,1259855],["يَتَسَآءَلُونَ",1259855,1264670]],"translation":"So when the Horn is blown, no relationship will there be among them that Day, nor will they ask about one another."},{"n":102,"from":1264770,"to":1274750,"words":[["فَمَن",1264695,1265745],["ثَقُلَتْ",1265745,1266625],["مَوَٰزِينُهُۥ",1266625,1268235],["فَأُو۟لَـٰٓئِكَ",1268235,1270945],["هُمُ",1270945,1271315],["ٱلْمُفْلِحُونَ",1271315,1274630]],"translation":"And those whose scales are heavy [with good deeds] - it is they who are the successful."},{"n":103,"from":1274750,"to":1292510,"words":[["وَمَنْ",1274705,1275285],["خَفَّتْ",1275285,1276135],["مَوَٰزِينُهُۥ",1276135,1277675],["فَأُو۟لَـٰٓئِكَ",1277675,1280495],["ٱلَّذِينَ",1280495,1281505],["خَسِرُوٓا۟",1282435,1285215],["أَنفُسَهُمْ",1285215,1287105],["فِى",1287105,1287465],["جَهَنَّمَ",1287465,1289325],["خَـٰلِدُونَ",1289325,1292440]],"translation":"But those whose scales are light - those are the ones who have lost their souls, [being] in Hell, abiding eternally."},{"n":104,"from":1292510,"to":1301080,"words":[["تَلْفَحُ",1292485,1293345],["وُجُوهَهُمُ",1293345,1294645],["ٱلنَّارُ",1294645,1295965],["وَهُمْ",1295965,1296505],["فِيهَا",1296505,1297255],["كَـٰلِحُونَ",1297255,1301020]],"translation":"The Fire will sear their faces, and they therein will have taut smiles."},{"n":105,"from":1301080,"to":1312310,"words":[["أَلَمْ",1301045,1301665],["تَكُنْ",1301665,1302325],["ءَايَـٰتِى",1302325,1303545],["تُتْلَىٰ",1303545,1304385],["عَلَيْكُمْ",1304385,1305395],["فَكُنتُم",1305395,1307575],["بِهَا",1307575,1308525],["تُكَذِّبُونَ",1308525,1312250]],"translation":"[It will be said], \"Were not My verses recited to you and you used to deny them?\""},{"n":106,"from":1312310,"to":1326860,"words":[["قَالُوا۟",1312285,1313195],["رَبَّنَا",1313195,1314215],["غَلَبَتْ",1314215,1314995],["عَلَيْنَا",1314995,1315995],["شِقْوَتُنَا",1315995,1317195],["وَكُنَّا",1317195,1318985],["قَوْمًۭا",1318985,1320595],["ضَآلِّينَ",1320595,1326780]],"translation":"They will say, \"Our Lord, our wretchedness overcame us, and we were a people astray."},{"n":107,"from":1326860,"to":1337600,"words":[["رَبَّنَآ",1326805,1329525],["أَخْرِجْنَا",1329525,1330745],["مِنْهَا",1330745,1331545],["فَإِنْ",1331545,1332125],["عُدْنَا",1332125,1332885],["فَإِنَّا",1332885,1334365],["ظَـٰلِمُونَ",1334365,1337520]],"translation":"Our Lord, remove us from it, and if we were to return [to evil], we would indeed be wrongdoers.\""},{"n":108,"from":1337600,"to":1344000,"words":[["قَالَ",1337575,1338225],["ٱخْسَـُٔوا۟",1338225,1339005],["فِيهَا",1339005,1339915],["وَلَا",1339915,1340435],["تُكَلِّمُونِ",1340435,1343940]],"translation":"He will say, \"Remain despised therein and do not speak to Me."},{"n":109,"from":1344000,"to":1371900,"words":[["إِنَّهُۥ",1343965,1345475],["كَانَ",1345475,1346075],["فَرِيقٌۭ",1346075,1346965],["مِّنْ",1346965,1348475],["عِبَادِى",1348475,1349555],["يَقُولُونَ",1357295,1359165],["رَبَّنَآ",1359165,1360115],["ءَامَنَّا",1360115,1363854],["فَٱغْفِرْ",1363855,1364615],["لَنَا",1364615,1365345],["وَٱرْحَمْنَا",1365345,1366475],["وَأَنتَ",1366475,1368075],["خَيْرُ",1368075,1368745],["ٱلرَّٰحِمِينَ",1368745,1371840]],"translation":"Indeed, there was a party of My servants who said, 'Our Lord, we have believed, so forgive us and have mercy upon us, and You are the best of the merciful.'"},{"n":110,"from":1371900,"to":1387160,"words":[["فَٱتَّخَذْتُمُوهُمْ",1371875,1373915],["سِخْرِيًّا",1373915,1375125],["حَتَّىٰٓ",1375125,1377595],["أَنسَوْكُمْ",1377595,1379365],["ذِكْرِى",1379365,1380095],["وَكُنتُم",1380095,1381985],["مِّنْهُمْ",1381985,1383635],["تَضْحَكُونَ",1383635,1387110]],"translation":"But you took them in mockery to the point that they made you forget My remembrance, and you used to laugh at them."},{"n":111,"from":1387160,"to":1400380,"words":[["إِنِّى",1387135,1388735],["جَزَيْتُهُمُ",1388735,1389965],["ٱلْيَوْمَ",1389965,1390715],["بِمَا",1390715,1391265],["صَبَرُوٓا۟",1391265,1393455],["أَنَّهُمْ",1393455,1395315],["هُمُ",1395315,1395675],["ٱلْفَآئِزُونَ",1395675,1400290]],"translation":"Indeed, I have rewarded them this Day for their patient endurance - that they are the attainers [of success].\""},{"n":112,"from":1400380,"to":1406910,"words":[["قَـٰلَ",1400315,1401045],["كَمْ",1401045,1401345],["لَبِثْتُمْ",1401345,1402385],["فِى",1402385,1402625],["ٱلْأَرْضِ",1402625,1403405],["عَدَدَ",1403405,1404045],["سِنِينَ",1404045,1406820]],"translation":"[Allāh] will say, \"How long did you remain on earth in number of years?\""},{"n":113,"from":1406910,"to":1419290,"words":[["قَالُوا۟",1406885,1407685],["لَبِثْنَا",1407685,1408715],["يَوْمًا",1408715,1409575],["أَوْ",1409575,1409955],["بَعْضَ",1409955,1410615],["يَوْمٍۢ",1410615,1412455],["فَسْـَٔلِ",1412455,1413315],["ٱلْعَآدِّينَ",1413315,1419240]],"translation":"They will say, \"We remained a day or part of a day; ask those who enumerate.\""},{"n":114,"from":1419290,"to":1430470,"words":[["قَـٰلَ",1419265,1419935],["إِن",1419935,1420145],["لَّبِثْتُمْ",1420145,1421355],["إِلَّا",1421355,1422195],["قَلِيلًۭا ۖ",1422195,1423145],["لَّوْ",1423145,1423725],["أَنَّكُمْ",1423725,1425545],["كُنتُمْ",1425545,1427355],["تَعْلَمُونَ",1427355,1430390]],"translation":"He will say, \"You stayed not but a little - if only you had known."},{"n":115,"from":1430470,"to":1442980,"words":[["أَفَحَسِبْتُمْ",1430415,1431975],["أَنَّمَا",1431975,1433455],["خَلَقْنَـٰكُمْ",1433455,1435025],["عَبَثًۭا",1435025,1435845],["وَأَنَّكُمْ",1435845,1438425],["إِلَيْنَا",1438425,1439515],["لَا",1439515,1439915],["تُرْجَعُونَ",1439915,1442900]],"translation":"Then did you think that We created you uselessly and that to Us you would not be returned?\""},{"n":116,"from":1442980,"to":1455990,"words":[["فَتَعَـٰلَى",1442955,1444005],["ٱللَّهُ",1444005,1444925],["ٱلْمَلِكُ",1444925,1445835],["ٱلْحَقُّ ۖ",1445835,1447095],["لَآ",1447095,1448885],["إِلَـٰهَ",1448885,1449685],["إِلَّا",1449685,1450615],["هُوَ",1450615,1450945],["رَبُّ",1450945,1451595],["ٱلْعَرْشِ",1451595,1452545],["ٱلْكَرِيمِ",1452545,1455910]],"translation":"So exalted is Allāh, the Sovereign, the Truth; there is no deity except Him, Lord of the Noble Throne."},{"n":117,"from":1455990,"to":1476210,"words":[["وَمَن",1455935,1456425],["يَدْعُ",1456425,1457785],["مَعَ",1457785,1458155],["ٱللَّهِ",1458155,1459045],["إِلَـٰهًا",1459045,1460115],["ءَاخَرَ",1460115,1461025],["لَا",1461025,1461405],["بُرْهَـٰنَ",1461405,1462415],["لَهُۥ",1462415,1463085],["بِهِۦ",1463085,1463745],["فَإِنَّمَا",1463745,1465515],["حِسَابُهُۥ",1465515,1466885],["عِندَ",1466885,1468195],["رَبِّهِۦٓ ۚ",1468195,1469555],["إِنَّهُۥ",1469555,1471165],["لَا",1471165,1471635],["يُفْلِحُ",1471635,1472435],["ٱلْكَـٰفِرُونَ",1472435,1476130]],"translation":"And whoever invokes besides Allāh another deity for which he has no proof - then his account is only with his Lord. Indeed, the disbelievers will not succeed."},{"n":118,"from":1476210,"to":1486450,"words":[["وَقُل",1476185,1476625],["رَّبِّ",1476625,1477435],["ٱغْفِرْ",1477435,1478155],["وَٱرْحَمْ",1478155,1478895],["وَأَنتَ",1478895,1480535],["خَيْرُ",1480535,1481225],["ٱلرَّٰحِمِينَ",1481225,1486390]],"translation":"And, [O Muḥammad], say, \"My Lord, forgive and have mercy, and You are the best of the merciful.\""}]}
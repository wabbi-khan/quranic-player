{"number":55,"audio":"https://download.quranicaudio.com/qdc/mishari_al_afasy/murattal/55.mp3","verses":[{"n":1,"from":0,"to":4620,"words":[["ٱلرَّحْمَـٰنُ",0,4545]],"translation":"The Most Merciful"},{"n":2,"from":4620,"to":9430,"words":[["عَلَّمَ",4545,5405],["ٱلْقُرْءَانَ",5405,9270]],"translation":"Taught the Qur’ān,"},{"n":3,"from":9430,"to":14970,"words":[["خَلَقَ",9345,10065],["ٱلْإِنسَـٰنَ",10065,14820]],"translation":"Created man,"},{"n":4,"from":14970,"to":19910,"words":[["عَلَّمَهُ",14905,15985],["ٱلْبَيَانَ",15985,19780]],"translation":"[And] taught him eloquence."},{"n":5,"from":19910,"to":26230,"words":[["ٱلشَّمْسُ",19845,20975],["وَٱلْقَمَرُ",20975,22025],["بِحُسْبَانٍۢ",22025,26110]],"translation":"The sun and the moon [move] by precise calculation,"},{"n":6,"from":26230,"to":32600,"words":[["وَٱلنَّجْمُ",26175,27885],["وَٱلشَّجَرُ",27885,28885],["يَسْجُدَانِ",28885,32520]],"translation":"And the stars and trees prostrate."},{"n":7,"from":32600,"to":41060,"words":[["وَٱلسَّمَآءَ",32575,35455],["رَفَعَهَا",35455,36535],["وَوَضَعَ",36535,37395],["ٱلْمِيزَانَ",37395,40980]],"translation":"And the heaven He raised and imposed the balance"},{"n":8,"from":41060,"to":47020,"words":[["أَلَّا",41005,41895],["تَطْغَوْا۟",41895,42785],["فِى",42785,43035],["ٱلْمِيزَانِ",43035,46920]],"translation":"That you not transgress within the balance."},{"n":9,"from":47020,"to":55460,"words":[["وَأَقِيمُوا۟",46975,48075],["ٱلْوَزْنَ",48075,48985],["بِٱلْقِسْطِ",48985,50175],["وَلَا",50175,50795],["تُخْسِرُوا۟",50795,51675],["ٱلْمِيزَانَ",51675,55350]],"translation":"And establish weight in justice and do not make deficient the balance."},{"n":10,"from":55460,"to":61340,"words":[["وَٱلْأَرْضَ",55395,56625],["وَضَعَهَا",56625,57655],["لِلْأَنَامِ",57655,61030]],"translation":"And the earth He laid [out] for the creatures."},{"n":11,"from":61340,"to":71030,"words":[["فِيهَا",61095,62085],["فَـٰكِهَةٌۭ",62085,63185],["وَٱلنَّخْلُ",63185,66005],["ذَاتُ",66005,66705],["ٱلْأَكْمَامِ",66705,70470]],"translation":"Therein is fruit and palm trees having sheaths [of dates]"},{"n":12,"from":71030,"to":77670,"words":[["وَٱلْحَبُّ",70715,71825],["ذُو",71825,72015],["ٱلْعَصْفِ",72015,73015],["وَٱلرَّيْحَانُ",73015,77280]],"translation":"And grain having husks and scented plants."},{"n":13,"from":77670,"to":87310,"words":[["فَبِأَىِّ",77595,78695],["ءَالَآءِ",78695,81465],["رَبِّكُمَا",81465,82815],["تُكَذِّبَانِ",82815,87180]],"translation":"So which of the favors of your Lord would you deny?"},{"n":14,"from":87310,"to":98230,"words":[["خَلَقَ",87255,87995],["ٱلْإِنسَـٰنَ",87995,90155],["مِن",90155,91435],["صَلْصَـٰلٍۢ",91435,93635],["كَٱلْفَخَّارِ",93635,98110]],"translation":"He created man from clay like [that of] pottery."},{"n":15,"from":98230,"to":110220,"words":[["وَخَلَقَ",98165,99055],["ٱلْجَآنَّ",99055,103105],["مِن",103105,103365],["مَّارِجٍۢ",103365,105185],["مِّن",105185,106465],["نَّارٍۢ",106465,110040]],"translation":"And He created the jinn from a smokeless flame of fire."},{"n":16,"from":110220,"to":118970,"words":[["فَبِأَىِّ",110105,111245],["ءَالَآءِ",111245,113875],["رَبِّكُمَا",113875,115235],["تُكَذِّبَانِ",115235,118550]],"translation":"So which of the favors of your Lord would you deny?"},{"n":17,"from":118970,"to":125610,"words":[["رَبُّ",118665,119305],["ٱلْمَشْرِقَيْنِ",119305,120825],["وَرَبُّ",120825,121645],["ٱلْمَغْرِبَيْنِ",121645,125240]],"translation":"[He is] Lord of the two sunrises and Lord of the two sunsets."},{"n":18,"from":125610,"to":133970,"words":[["فَبِأَىِّ",125545,126705],["ءَالَآءِ",126705,129095],["رَبِّكُمَا",129095,130365],["تُكَذِّبَانِ",130365,133840]],"translation":"So which of the favors of your Lord would you deny?"},{"n":19,"from":133970,"to":139610,"words":[["مَرَجَ",133905,134605],["ٱلْبَحْرَيْنِ",134605,135875],["يَلْتَقِيَانِ",135875,139490]],"translation":"He released the two seas, meeting [one another];"},{"n":20,"from":139610,"to":146110,"words":[["بَيْنَهُمَا",139555,140875],["بَرْزَخٌۭ",140875,142035],["لَّا",142035,142395],["يَبْغِيَانِ",142395,146020]],"translation":"Between them is a barrier so neither of them transgresses."},{"n":21,"from":146110,"to":155510,"words":[["فَبِأَىِّ",146065,147155],["ءَالَآءِ",147155,150165],["رَبِّكُمَا",150165,151425],["تُكَذِّبَانِ",151425,155410]],"translation":"So which of the favors of your Lord would you deny?"},{"n":22,"from":155510,"to":162670,"words":[["يَخْرُجُ",155445,156375],["مِنْهُمَا",156375,157175],["ٱللُّؤْلُؤُ",157175,158365],["وَٱلْمَرْجَانُ",158365,162520]],"translation":"From both of them emerge pearl and coral."},{"n":23,"from":162670,"to":171290,"words":[["فَبِأَىِّ",162585,163675],["ءَالَآءِ",163675,166355],["رَبِّكُمَا",166355,167635],["تُكَذِّبَانِ",167635,171150]],"translation":"So which of the favors of your Lord would you deny?"},{"n":24,"from":171290,"to":180250,"words":[["وَلَهُ",171235,171865],["ٱلْجَوَارِ",171865,173105],["ٱلْمُنشَـَٔاتُ",173105,175385],["فِى",175385,175675],["ٱلْبَحْرِ",175675,176575],["كَٱلْأَعْلَـٰمِ",176575,180090]],"translation":"And to Him belong the ships [with sails] elevated in the sea like mountains."},{"n":25,"from":180250,"to":189470,"words":[["فَبِأَىِّ",180145,181235],["ءَالَآءِ",181235,183675],["رَبِّكُمَا",183675,184985],["تُكَذِّبَانِ",184985,189300]],"translation":"So which of the favors of your Lord would you deny?"},{"n":26,"from":189470,"to":194900,"words":[["كُلُّ",189405,190025],["مَنْ",190025,190375],["عَلَيْهَا",190375,191505],["فَانٍۢ",191505,194790]],"translation":"Everyone upon it [i.e., the earth] will perish,"},{"n":27,"from":194900,"to":203310,"words":[["وَيَبْقَىٰ",194855,195905],["وَجْهُ",195905,196555],["رَبِّكَ",196555,197395],["ذُو",197395,197605],["ٱلْجَلَـٰلِ",197605,198705],["وَٱلْإِكْرَامِ",198705,203180]],"translation":"And there will remain the Face of your Lord, Owner of Majesty and Honor."},{"n":28,"from":203310,"to":212610,"words":[["فَبِأَىِّ",203225,204295],["ءَالَآءِ",204295,207015],["رَبِّكُمَا",207015,208355],["تُكَذِّبَانِ",208355,212440]],"translation":"So which of the favors of your Lord would you deny?"},{"n":29,"from":212610,"to":221700,"words":[["يَسْـَٔلُهُۥ",212525,213755],["مَن",213755,215005],["فِى",215005,215145],["ٱلسَّمَـٰوَٰتِ",215145,216835],["وَٱلْأَرْضِ ۚ",216835,218225],["كُلَّ",218225,218725],["يَوْمٍ",218725,219665],["هُوَ",219665,220015],["فِى",220015,220525],["شَأْنٍۢ",220525,221540]],"translation":"Whoever is within the heavens and earth asks Him; every day He is in [i.e., bringing about] a matter."},{"n":30,"from":221700,"to":230530,"words":[["فَبِأَىِّ",221625,222685],["ءَالَآءِ",222685,225084],["رَبِّكُمَا",225085,226375],["تُكَذِّبَانِ",226375,230400]],"translation":"So which of the favors of your Lord would you deny?"},{"n":31,"from":230530,"to":237060,"words":[["سَنَفْرُغُ",230475,231615],["لَكُمْ",231615,232235],["أَيُّهَ",232235,233125],["ٱلثَّقَلَانِ",233125,236940]],"translation":"We will attend to you, O prominent beings."},{"n":32,"from":237060,"to":245860,"words":[["فَبِأَىِّ",236995,238065],["ءَالَآءِ",238065,240375],["رَبِّكُمَا",240375,241615],["تُكَذِّبَانِ",241615,245730]],"translation":"So which of the favors of your Lord would you deny?"},{"n":33,"from":245860,"to":269810,"words":[["يَـٰمَعْشَرَ",245795,247075],["ٱلْجِنِّ",247075,248805],["وَٱلْإِنسِ",248805,250885],["إِنِ",250885,251245],["ٱسْتَطَعْتُمْ",251245,252565],["أَن",252565,253595],["تَنفُذُوا۟",253595,255455],["مِنْ",255455,255875],["أَقْطَارِ",255875,256945],["ٱلسَّمَـٰوَٰتِ",256945,258595],["وَٱلْأَرْضِ",258595,259705],["فَٱنفُذُوا۟ ۚ",259705,261495],["لَا",261495,262655],["تَنفُذُونَ",262655,264525],["إِلَّا",264525,265425],["بِسُلْطَـٰنٍۢ",265425,269310]],"translation":"O company of jinn and mankind, if you are able to pass beyond the regions of the heavens and the earth, then pass. You will not pass except by authority [from Allāh]."},{"n":34,"from":269810,"to":278640,"words":[["فَبِأَىِّ",269365,270495],["ءَالَآءِ",270495,272925],["رَبِّكُمَا",272925,274245],["تُكَذِّبَانِ",274245,278140]],"translation":"So which of the favors of your Lord would you deny?"},{"n":35,"from":278640,"to":293190,"words":[["يُرْسَلُ",278585,279525],["عَلَيْكُمَا",279525,280765],["شُوَاظٌۭ",280765,281765],["مِّن",281765,283155],["نَّارٍۢ",283155,284945],["وَنُحَاسٌۭ",284945,287535],["فَلَا",287535,288205],["تَنتَصِرَانِ",288205,292980]],"translation":"There will be sent upon you a flame of fire and smoke, and you will not defend yourselves."},{"n":36,"from":293190,"to":302930,"words":[["فَبِأَىِّ",293035,294125],["ءَالَآءِ",294125,296935],["رَبِّكُمَا",296935,298275],["تُكَذِّبَانِ",298275,302720]],"translation":"So which of the favors of your Lord would you deny?"},{"n":37,"from":302930,"to":315160,"words":[["فَإِذَا",302875,303545],["ٱنشَقَّتِ",303545,305555],["ٱلسَّمَآءُ",305555,308355],["فَكَانَتْ",308355,309495],["وَرْدَةًۭ",309495,311405],["كَٱلدِّهَانِ",311405,315040]],"translation":"And when the heaven is split open and becomes rose-colored like oil -"},{"n":38,"from":315160,"to":323990,"words":[["فَبِأَىِّ",315095,316175],["ءَالَآءِ",316175,318805],["رَبِّكُمَا",318805,319995],["تُكَذِّبَانِ",319995,323850]],"translation":"So which of the favors of your Lord would you deny? -"},{"n":39,"from":323990,"to":339060,"words":[["فَيَوْمَئِذٍۢ",323915,325405],["لَّا",325405,325905],["يُسْـَٔلُ",325905,326745],["عَن",326745,327915],["ذَنۢبِهِۦٓ",327915,331195],["إِنسٌۭ",331195,333744],["وَلَا",333745,334385],["جَآنٌّۭ",334385,338590]],"translation":"Then on that Day none will be asked about his sin among men or jinn."},{"n":40,"from":339060,"to":348700,"words":[["فَبِأَىِّ",338665,339795],["ءَالَآءِ",339795,342555],["رَبِّكُمَا",342555,343865],["تُكَذِّبَانِ",343865,348170]],"translation":"So which of the favors of your Lord would you deny?"},{"n":41,"from":348700,"to":360300,"words":[["يُعْرَفُ",348565,349445],["ٱلْمُجْرِمُونَ",349445,351015],["بِسِيمَـٰهُمْ",351015,352625],["فَيُؤْخَذُ",352625,353835],["بِٱلنَّوَٰصِى",353835,356085],["وَٱلْأَقْدَامِ",356085,359820]],"translation":"The criminals will be known by their marks, and they will be seized by the forelocks and the feet."},{"n":42,"from":360300,"to":369600,"words":[["فَبِأَىِّ",359955,361105],["ءَالَآءِ",361105,363585],["رَبِّكُمَا",363585,364895],["تُكَذِّبَانِ",364895,369200]],"translation":"So which of the favors of your Lord would you deny?"},{"n":43,"from":369600,"to":378560,"words":[["هَـٰذِهِۦ",369545,370715],["جَهَنَّمُ",370715,372325],["ٱلَّتِى",372325,373305],["يُكَذِّبُ",373305,374445],["بِهَا",374445,374835],["ٱلْمُجْرِمُونَ",374835,378420]],"translation":"This is Hell, which the criminals deny."},{"n":44,"from":378560,"to":386760,"words":[["يَطُوفُونَ",378475,379905],["بَيْنَهَا",379905,381135],["وَبَيْنَ",381135,381885],["حَمِيمٍ",381885,383175],["ءَانٍۢ",383175,386600]],"translation":"They will circulate between it and scalding water, heated [to the utmost degree]."},{"n":45,"from":386760,"to":396350,"words":[["فَبِأَىِّ",386685,387815],["ءَالَآءِ",387815,390525],["رَبِّكُمَا",390525,391845],["تُكَذِّبَانِ",391845,396200]],"translation":"So which of the favors of your Lord would you deny?"},{"n":46,"from":396350,"to":404470,"words":[["وَلِمَنْ",396275,396985],["خَافَ",396985,397815],["مَقَامَ",397815,398735],["رَبِّهِۦ",398735,399845],["جَنَّتَانِ",399845,404340]],"translation":"But for he who has feared the position of his Lord are two gardens -"},{"n":47,"from":404470,"to":413800,"words":[["فَبِأَىِّ",404405,405535],["ءَالَآءِ",405535,408245],["رَبِّكُمَا",408245,409545],["تُكَذِّبَانِ",409545,413670]],"translation":"So which of the favors of your Lord would you deny? -"},{"n":48,"from":413800,"to":419830,"words":[["ذَوَاتَآ",413735,414575],["أَفْنَانٍۢ",416475,419660]],"translation":"Having [spreading] branches."},{"n":49,"from":419830,"to":428740,"words":[["فَبِأَىِّ",419715,420825],["ءَالَآءِ",420825,423235],["رَبِّكُمَا",423235,424505],["تُكَذِّبَانِ",424505,428570]],"translation":"So which of the favors of your Lord would you deny?"},{"n":50,"from":428740,"to":434770,"words":[["فِيهِمَا",428685,429855],["عَيْنَانِ",429855,431045],["تَجْرِيَانِ",431045,434670]],"translation":"In both of them are two springs, flowing."},{"n":51,"from":434770,"to":443310,"words":[["فَبِأَىِّ",434715,435835],["ءَالَآءِ",435835,438395],["رَبِّكُمَا",438395,439695],["تُكَذِّبَانِ",439695,443220]],"translation":"So which of the favors of your Lord would you deny?"},{"n":52,"from":443310,"to":451900,"words":[["فِيهِمَا",443275,444435],["مِن",444435,445725],["كُلِّ",445725,446355],["فَـٰكِهَةٍۢ",446355,448545],["زَوْجَانِ",448545,451810]],"translation":"In both of them are of every fruit, two kinds."},{"n":53,"from":451900,"to":460360,"words":[["فَبِأَىِّ",451835,452945],["ءَالَآءِ",452945,455485],["رَبِّكُمَا",455485,456715],["تُكَذِّبَانِ",456715,460260]],"translation":"So which of the favors of your Lord would you deny?"},{"n":54,"from":460360,"to":475070,"words":[["مُتَّكِـِٔينَ",460325,461785],["عَلَىٰ",461785,462465],["فُرُشٍۭ",462465,464005],["بَطَآئِنُهَا",464005,466915],["مِنْ",466915,467365],["إِسْتَبْرَقٍۢ ۚ",467365,468995],["وَجَنَى",468995,469595],["ٱلْجَنَّتَيْنِ",469595,472015],["دَانٍۢ",472015,474980]],"translation":"[They are] reclining on beds whose linings are of silk brocade, and the fruit of the two gardens is hanging low."},{"n":55,"from":475070,"to":484110,"words":[["فَبِأَىِّ",475015,476115],["ءَالَآءِ",476115,478525],["رَبِّكُمَا",478525,479795],["تُكَذِّبَانِ",479795,483980]],"translation":"So which of the favors of your Lord would you deny?"},{"n":56,"from":484110,"to":499650,"words":[["فِيهِنَّ",484035,485725],["قَـٰصِرَٰتُ",485725,487025],["ٱلطَّرْفِ",487025,488035],["لَمْ",488035,488345],["يَطْمِثْهُنَّ",488345,490675],["إِنسٌۭ",490675,493365],["قَبْلَهُمْ",493365,494575],["وَلَا",494575,495215],["جَآنٌّۭ",495215,499170]],"translation":"In them are women limiting [their] glances, untouched before them by man or jinnī -"},{"n":57,"from":499650,"to":508610,"wo
{"number":56,"audio":"https://download.quranicaudio.com/qdc/mishari_al_afasy/murattal/56.mp3","verses":[{"n":1,"from":0,"to":3550,"words":[["إِذَا",0,670],["وَقَعَتِ",670,1660],["ٱلْوَاقِعَةُ",1660,3485]],"translation":"When the Occurrence occurs,"},{"n":2,"from":3550,"to":7680,"words":[["لَيْسَ",3485,4285],["لِوَقْعَتِهَا",4285,5825],["كَاذِبَةٌ",5825,7510]],"translation":"There is, at its occurrence, no denial."},{"n":3,"from":7680,"to":10920,"words":[["خَافِضَةٌۭ",7575,9065],["رَّافِعَةٌ",9065,10730]],"translation":"It will bring down [some] and raise up [others]."},{"n":4,"from":10920,"to":15050,"words":[["إِذَا",10835,11305],["رُجَّتِ",11305,12445],["ٱلْأَرْضُ",12445,13345],["رَجًّۭا",13345,14400]],"translation":"When the earth is shaken with convulsion"},{"n":5,"from":15050,"to":19050,"words":[["وَبُسَّتِ",14485,15665],["ٱلْجِبَالُ",15665,16835],["بَسًّۭا",16835,18020]],"translation":"And the mountains are broken down, crumbling"},{"n":6,"from":19050,"to":26420,"words":[["فَكَانَتْ",18585,19725],["هَبَآءًۭ",19725,22055],["مُّنۢبَثًّۭا",22055,25410]],"translation":"And become dust dispersing,"},{"n":7,"from":26420,"to":32430,"words":[["وَكُنتُمْ",25875,27855],["أَزْوَٰجًۭا",27855,30065],["ثَلَـٰثَةًۭ",30065,31770]],"translation":"And you become [of] three kinds:"},{"n":8,"from":32430,"to":40060,"words":[["فَأَصْحَـٰبُ",32315,33625],["ٱلْمَيْمَنَةِ",33625,35085],["مَآ",35085,36715],["أَصْحَـٰبُ",36715,37855],["ٱلْمَيْمَنَةِ",37855,39870]],"translation":"Then the companions of the right - what are the companions of the right?"},{"n":9,"from":40060,"to":48030,"words":[["وَأَصْحَـٰبُ",39985,41325],["ٱلْمَشْـَٔمَةِ",41325,42845],["مَآ",42845,44815],["أَصْحَـٰبُ",44815,45955],["ٱلْمَشْـَٔمَةِ",45955,47560]],"translation":"And the companions of the left - what are companions of the left?"},{"n":10,"from":48030,"to":54040,"words":[["وَٱلسَّـٰبِقُونَ",47635,49465],["ٱلسَّـٰبِقُونَ",49465,53570]],"translation":"And the forerunners, the forerunners -"},{"n":11,"from":54040,"to":60780,"words":[["أُو۟لَـٰٓئِكَ",53965,56515],["ٱلْمُقَرَّبُونَ",56515,60640]],"translation":"Those are the ones brought near [to Allāh]"},{"n":12,"from":60780,"to":67520,"words":[["فِى",60715,61185],["جَنَّـٰتِ",61185,63225],["ٱلنَّعِيمِ",63225,67400]],"translation":"In the Gardens of Pleasure,"},{"n":13,"from":67520,"to":73760,"words":[["ثُلَّةٌۭ",67465,68585],["مِّنَ",68585,70015],["ٱلْأَوَّلِينَ",70015,73660]],"translation":"A [large] company of the former peoples"},{"n":14,"from":73760,"to":80530,"words":[["وَقَلِيلٌۭ",73715,74925],["مِّنَ",74925,76455],["ٱلْـَٔاخِرِينَ",76455,80410]],"translation":"And a few of the later peoples,"},{"n":15,"from":80530,"to":84810,"words":[["عَلَىٰ",80455,81145],["سُرُرٍۢ",81145,81835],["مَّوْضُونَةٍۢ",81835,84680]],"translation":"On thrones woven [with ornament],"},{"n":16,"from":84810,"to":91810,"words":[["مُّتَّكِـِٔينَ",84745,86305],["عَلَيْهَا",86305,87575],["مُتَقَـٰبِلِينَ",87575,91690]],"translation":"Reclining on them, facing each other."},{"n":17,"from":91810,"to":99910,"words":[["يَطُوفُ",91755,92645],["عَلَيْهِمْ",92645,93965],["وِلْدَٰنٌۭ",93965,95445],["مُّخَلَّدُونَ",95445,99730]],"translation":"There will circulate among them young boys made eternal."},{"n":18,"from":99910,"to":110250,"words":[["بِأَكْوَابٍۢ",99785,102205],["وَأَبَارِيقَ",102205,103885],["وَكَأْسٍۢ",103885,105095],["مِّن",105095,106115],["مَّعِينٍۢ",106115,110030]],"translation":"With vessels, pitchers and a cup [of wine] from a flowing spring -"},{"n":19,"from":110250,"to":118530,"words":[["لَّا",110145,110655],["يُصَدَّعُونَ",110655,112285],["عَنْهَا",112285,113175],["وَلَا",113175,113885],["يُنزِفُونَ",113885,118360]],"translation":"No headache will they have therefrom, nor will they be intoxicated -"},{"n":20,"from":118530,"to":126810,"words":[["وَفَـٰكِهَةٍۢ",118465,120105],["مِّمَّا",120105,122435],["يَتَخَيَّرُونَ",122435,126690]],"translation":"And fruit of what they select"},{"n":21,"from":126810,"to":135300,"words":[["وَلَحْمِ",126755,127665],["طَيْرٍۢ",127665,128335],["مِّمَّا",128335,131465],["يَشْتَهُونَ",131465,135160]],"translation":"And the meat of fowl, from whatever they desire."},{"n":22,"from":135300,"to":139690,"words":[["وَحُورٌ",135215,136365],["عِينٌۭ",136365,139460]],"translation":"And [for them are] fair women with large, [beautiful] eyes,"},{"n":23,"from":139690,"to":145910,"words":[["كَأَمْثَـٰلِ",139545,140835],["ٱللُّؤْلُؤِ",140835,142075],["ٱلْمَكْنُونِ",142075,145640]],"translation":"The likenesses of pearls well-protected,"},{"n":24,"from":145910,"to":154900,"words":[["جَزَآءًۢ",145785,149414],["بِمَا",149415,149865],["كَانُوا۟",149865,151195],["يَعْمَلُونَ",151195,154670]],"translation":"As reward for what they used to do."},{"n":25,"from":154900,"to":162370,"words":[["لَا",154795,155315],["يَسْمَعُونَ",155315,156705],["فِيهَا",156705,157715],["لَغْوًۭا",157715,158515],["وَلَا",158515,160045],["تَأْثِيمًا",160045,161680]],"translation":"They will not hear therein ill speech or commission of sin -"},{"n":26,"from":162370,"to":168820,"words":[["إِلَّا",161785,162685],["قِيلًۭا",162685,164255],["سَلَـٰمًۭا",164255,165765],["سَلَـٰمًۭا",165765,168180]],"translation":"Only a saying [of] peace, peace."},{"n":27,"from":168820,"to":177860,"words":[["وَأَصْحَـٰبُ",168765,170125],["ٱلْيَمِينِ",170125,171425],["مَآ",171425,173295],["أَصْحَـٰبُ",173295,174465],["ٱلْيَمِينِ",174465,177740]],"translation":"The companions of the right - what are the companions of the right?"},{"n":28,"from":177860,"to":183320,"words":[["فِى",177795,178235],["سِدْرٍۢ",178235,178965],["مَّخْضُودٍۢ",178965,183190]],"translation":"[They will be] among lote trees with thorns removed."},{"n":29,"from":183320,"to":189040,"words":[["وَطَلْحٍۢ",183255,184145],["مَّنضُودٍۢ",184145,188910]],"translation":"And [banana] trees layered [with fruit]."},{"n":30,"from":189040,"to":194470,"words":[["وَظِلٍّۢ",188975,190005],["مَّمْدُودٍۢ",190005,194320]],"translation":"And shade extended."},{"n":31,"from":194470,"to":201290,"words":[["وَمَآءٍۢ",194385,196895],["مَّسْكُوبٍۢ",196895,201140]],"translation":"And water poured out"},{"n":32,"from":201290,"to":205470,"words":[["وَفَـٰكِهَةٍۢ",201225,203775],["كَثِيرَةٍۢ",203775,205360]],"translation":"And fruit, abundant [and varied],"},{"n":33,"from":205470,"to":210690,"words":[["لَّا",205425,205955],["مَقْطُوعَةٍۢ",205955,208315],["وَلَا",208315,208965],["مَمْنُوعَةٍۢ",208965,210590]],"translation":"Neither limited [to season] nor forbidden,"},{"n":34,"from":210690,"to":214270,"words":[["وَفُرُشٍۢ",210625,211665],["مَّرْفُوعَةٍ",211665,214160]],"translation":"And [upon] beds raised high."},{"n":35,"from":214270,"to":225450,"words":[["إِنَّآ",214225,217015],["أَنشَأْنَـٰهُنَّ",217015,220575],["إِنشَآءًۭ",220575,225330]],"translation":"Indeed, We have produced them [i.e., the women of Paradise] in a [new] creation"},{"n":36,"from":225450,"to":230390,"words":[["فَجَعَلْنَـٰهُنَّ",225375,228085],["أَبْكَارًا",228085,230260]],"translation":"And made them virgins,"},{"n":37,"from":230390,"to":233370,"words":[["عُرُبًا",230335,231275],["أَتْرَابًۭا",231275,233250]],"translation":"Devoted [to their husbands] and of equal age,"},{"n":38,"from":233370,"to":238020,"words":[["لِّأَصْحَـٰبِ",233305,234565],["ٱلْيَمِينِ",234565,237830]],"translation":"For the companions of the right [who are]"},{"n":39,"from":238020,"to":244000,"words":[["ثُلَّةٌۭ",237895,238955],["مِّنَ",238955,240025],["ٱلْأَوَّلِينَ",240025,243810]],"translation":"A company of the former peoples"},{"n":40,"from":244000,"to":250400,"words":[["وَثُلَّةٌۭ",243935,245565],["مِّنَ",245565,246345],["ٱلْـَٔاخِرِينَ",246345,250260]],"translation":"And a company of the later peoples."},{"n":41,"from":250400,"to":259230,"words":[["وَأَصْحَـٰبُ",250325,251605],["ٱلشِّمَالِ",251605,252795],["مَآ",252795,254835],["أَصْحَـٰبُ",254835,255915],["ٱلشِّمَالِ",255915,258660]],"translation":"And the companions of the left - what are the companions of the left?"},{"n":42,"from":259230,"to":265290,"words":[["فِى",258735,259135],["سَمُومٍۢ",259135,260915],["وَحَمِيمٍۢ",260915,264760]],"translation":"[They will be] in scorching fire and scalding water"},{"n":43,"from":265290,"to":271380,"words":[["وَظِلٍّۢ",265255,266175],["مِّن",266175,268235],["يَحْمُومٍۢ",268235,271220]],"translation":"And a shade of black smoke,"},{"n":44,"from":271380,"to":277810,"words":[["لَّا",271255,271815],["بَارِدٍۢ",271815,273775],["وَلَا",273775,274375],["كَرِيمٍ",274375,277610]],"translation":"Neither cool nor beneficial."},{"n":45,"from":277810,"to":285990,"words":[["إِنَّهُمْ",277735,279665],["كَانُوا۟",279665,280605],["قَبْلَ",280605,281435],["ذَٰلِكَ",281435,282335],["مُتْرَفِينَ",282335,285790]],"translation":"Indeed they were, before that, indulging in affluence,"},{"n":46,"from":285990,"to":294110,"words":[["وَكَانُوا۟",285865,287035],["يُصِرُّونَ",287035,288405],["عَلَى",288405,288955],["ٱلْحِنثِ",288955,290725],["ٱلْعَظِيمِ",290725,293900]],"translation":"And they used to persist in the great violation,"},{"n":47,"from":294110,"to":309340,"words":[["وَكَانُوا۟",294015,295195],["يَقُولُونَ",295195,296535],["أَئِذَا",296535,297515],["مِتْنَا",297515,298435],["وَكُنَّا",298435,300125],["تُرَابًۭا",300125,301685],["وَعِظَـٰمًا",301685,303375],["أَءِنَّا",303375,305385],["لَمَبْعُوثُونَ",305385,309130]],"translation":"And they used to say, \"When we die and become dust and bones, are we indeed to be resurrected?"},{"n":48,"from":309340,"to":316210,"words":[["أَوَءَابَآؤُنَا",309225,312495],["ٱلْأَوَّلُونَ",312495,316030]],"translation":"And our forefathers [as well]?\""},{"n":49,"from":316210,"to":323730,"words":[["قُلْ",316145,316525],["إِنَّ",316525,317835],["ٱلْأَوَّلِينَ",317835,319545],["وَٱلْـَٔاخِرِينَ",319545,323580]],"translation":"Say, [O Muḥammad], \"Indeed, the former and later peoples"},{"n":50,"from":323730,"to":332980,"words":[["لَمَجْمُوعُونَ",323645,325455],["إِلَىٰ",325455,326235],["مِيقَـٰتِ",326235,327525],["يَوْمٍۢ",327525,328185],["مَّعْلُومٍۢ",328185,332680]],"translation":"Are to be gathered together for the appointment of a known Day.\""},{"n":51,"from":332980,"to":345680,"words":[["ثُمَّ",332765,334275],["إِنَّكُمْ",334275,336195],["أَيُّهَا",336195,337165],["ٱلضَّآلُّونَ",337165,341575],["ٱلْمُكَذِّبُونَ",341575,345390]],"translation":"Then indeed you, O those astray [who are] deniers,"},{"n":52,"from":345680,"to":355500,"words":[["لَـَٔاكِلُونَ",345605,347185],["مِن",347185,347645],["شَجَرٍۢ",347645,349455],["مِّن",349455,352055],["زَقُّومٍۢ",352055,355240]],"translation":"Will be eating from trees of zaqqūm"},{"n":53,"from":355500,"to":361250,"words":[["فَمَالِـُٔونَ",355315,356945],["مِنْهَا",356945,357605],["ٱلْبُطُونَ",357605,360980]],"translation":"And filling with it your bellies"},{"n":54,"from":361250,"to":367990,"words":[["فَشَـٰرِبُونَ",361165,362735],["عَلَيْهِ",362735,363725],["مِنَ",363725,364105],["ٱلْحَمِيمِ",364105,367820]],"translation":"And drinking on top of it from scalding water."},{"n":55,"from":367990,"to":373760,"words":[["فَشَـٰرِبُونَ",367905,369365],["شُرْبَ",369365,370035],["ٱلْهِيمِ",370035,373620]],"translation":"And will drink as the drinking of thirsty camels."},{"n":56,"from":373760,"to":379900,"words":[["هَـٰذَا",373705,374685],["نُزُلُهُمْ",374685,375855],["يَوْمَ",375855,376405],["ٱلدِّينِ",376405,379730]],"translation":"That is their accommodation on the Day of Recompense."},{"n":57,"from":379900,"to":387320,"words":[["نَحْنُ",379785,380465],["خَلَقْنَـٰكُمْ",380465,382105],["فَلَوْلَا",382105,383235],["تُصَدِّقُونَ",383235,387110]],"translation":"We have created you, so why do you not believe?"},{"n":58,"from":387320,"to":393880,"words":[["أَفَرَءَيْتُم",387225,388675],["مَّا",388675,390405],["تُمْنُونَ",390405,393670]],"translation":"Have you seen that which you emit?"},{"n":59,"from":393880,"to":403780,"words":[["ءَأَنتُمْ",393765,395605],["تَخْلُقُونَهُۥٓ",395605,398765],["أَمْ",398765,399295],["نَحْنُ",399295,399895],["ٱلْخَـٰلِقُونَ",399895,403620]],"translation":"Is it you who creates it, or are We the Creator?"},{"n":60,"from":403780,"to":413290,"words":[["نَحْنُ",403735,404465],["قَدَّرْنَا",404465,405805],["بَيْنَكُمُ",405805,406905],["ٱلْمَوْتَ",406905,407885],["وَمَا",407885,408565],["نَحْنُ",408565,409255],["بِمَسْبُوقِينَ",409255,413180]],"translation":"We have decreed death among you, and We are not to be outdone"},{"n":61,"from":413290,"to":426590,"words":[["عَلَىٰٓ",413225,415635],["أَن",415635,415915],["نُّبَدِّلَ",415915,417895],["أَمْثَـٰلَكُمْ",417895,419475],["وَنُنشِئَكُمْ",419475,421735],["فِى",421735,422165],["مَا",422165,422655],["لَا",422655,423055],["تَعْلَمُونَ",423055,426420]],"translation":"In that We will change your likenesses and produce you in that [form] which you do not know."},{"n":62,"from":426590,"to":436230,"words":[["وَلَقَدْ",426485,427315],["عَلِمْتُمُ",427315,428475],["ٱلنَّشْأَةَ",428475,430235],["ٱلْأُولَىٰ",430235,431345],["فَلَوْلَا",431345,432445],["تَذَكَّرُونَ",432445,436070]],"translation":"And you have already known the first creation, so will you not remember?"},{"n":63,"from":436230,"to":443150,"words":[["أَفَرَءَيْتُم",436175,437535],["مَّا",437535,438985],["تَحْرُثُونَ",438985,443020]],"translation":"And have you seen that [seed] which you sow?"},{"n":64,"from":443150,"to":452870,"words":[["ءَأَنتُمْ",443075,444995],["تَزْرَعُونَهُۥٓ",444995,448035],["أَمْ",448035,448525],["نَحْنُ",448525,449135],["ٱلزَّٰرِعُونَ",449135,452700]],"translation":"Is it you who makes it grow, or are We the grower?"},{"n":65,"from":452870,"to":464760,"words":[["لَوْ",452775,453135],["نَشَآءُ",453135,456065],["لَجَعَلْنَـٰهُ",456065,457555],["حُطَـٰمًۭا",457555,459165],["فَظَلْتُمْ",459165,460475],["تَفَكَّهُونَ",460475,464570]],"translation":"If We willed, We could make it [dry] debris, and you would remain in wonder,"},{"n":66,"from":464760,"to":470320,"words":[["إِنَّا",464665,466295],["لَمُغْرَمُونَ",466295,470130]],"translation":"[Saying], \"Indeed, we are [now] in debt;"},{"n":67,"from":470320,"to":475650,"words":[["بَلْ",470215,470695],["نَحْنُ",470695,471385],["مَحْرُومُونَ",471385,475450]],"translation":"Rather, we have been deprived.\""},{"n":68,"from":475650,"to":484740,"words":[["أَفَرَءَيْتُمُ",475555,477015],["ٱلْمَآءَ",477015,479735],["ٱلَّذِى",479735,480675],["تَشْرَبُونَ",480675,484570]],"translation":"And have you seen the water that you drink?"},{"n":69,"from":484740,"to":496780,"words":[["ءَأَنتُمْ",484665,486635],["أَنزَلْتُمُوهُ",486635,489295],["مِنَ",489295,489655],["ٱلْمُزْنِ",489655,490695],["أَمْ",490695,491165],["نَحْنُ",491165,491815],["ٱلْمُنزِلُونَ",491815,496630]],"translation":"Is it you who brought it down from the clouds, or is it We who bring it down?"},{"n":70,"from":496780,"to":507620,"words":[["لَوْ",496705,497135],["نَشَآءُ",497135,499715],["جَعَلْنَـٰهُ",499715,501115],["أُجَاجًۭا",501115,502815],["فَلَوْلَا",502815,503865],["تَشْكُرُونَ",503865,507450]],"translation":"If We willed, We could make it bitter, so why are you not grateful?"},{"n":71,"from":507620,"to":515950,"words":[["أَفَرَءَيْتُمُ",507525,509025],["ٱلنَّارَ",509025,510875],["ٱلَّتِى",510875,511835],["تُورُونَ",511835,515760]],"translation":"And have you seen the fire that you ignite?"},{"n":72,"from":515950,"to":529350,"words":[["ءَأَنتُمْ",515855,517695],["أَنشَأْتُمْ",517695,520065],["شَجَرَتَهَآ",520065,523025],["أَمْ",523025,523425],["نَحْنُ",523425,524135],["ٱلْمُنشِـُٔونَ",524135,529180]],"translation":"Is it you who produced its tree, or are We the producer?"},{"n":73,"from":529350,"to":539200,"words":[["نَحْنُ",529275,529955],["جَعَلْنَـٰهَا",529955,531515],["تَذْكِرَةًۭ",531515,533265],["وَمَتَـٰعًۭا",533265,535025],["لِّلْمُقْوِينَ",535025,539030]],"translation":"We have made it a reminder and provision for the travelers,"},{"n":74,"from":539200,"to":545100,"words":[["فَسَبِّحْ",539105,540185],["بِٱسْمِ",540185,540795],["رَبِّكَ",540795,541685],["ٱلْعَظِيمِ",541685,544880]],"translation":"So exalt the name of your Lord, the Most Great."},{"n":75,"from":545100,"to":553590,"words":[["۞ فَلَآ",544975,546875],["أُقْسِمُ",546875,547765],["بِمَوَٰقِعِ",547765,549055],["ٱلنُّجُومِ",549055,553350]],"translation":"Then I swear by the setting of the stars,"},{"n":76,"from":553590,"to":562260,"words":[["وَإِنَّهُۥ",553475,555425],["لَقَسَمٌۭ",555425,556365],["لَّوْ",556365,557065],["تَعْلَمُونَ",557065,558385],["عَظِيمٌ",558385,562090]],"translation":"And indeed, it is an oath - if you could know - [most] great."},{"n":77,"from":562260,"to":569970,"words":[["إِنَّهُۥ",562205,564215],["لَقُرْءَانٌۭ",564215,566635],["كَرِيمٌۭ",566635,569830]],"translation":"Indeed, it is a noble Qur’ān."},{"n":78,"from":569970,"to":575660,"words":[["فِى",569885,570375],["كِتَـٰبٍۢ",570375,571445],["مَّكْنُونٍۢ",571445,575420]],"translation":"In a Register well-protected;."},{"n":79,"from":575660,"to":583710,"words":[["لَّا",575495,576015],["يَمَسُّهُۥٓ",576015,578785],["إِلَّا",578785,579415],["ٱلْمُطَهَّرُونَ",579415,583430]],"translation":"None touch it except the purified [i.e., the angels]."},{"n":80,"from":583710,"to":591810,"words":[["تَنزِيلٌۭ",583595,586285],["مِّن",586285,587105],["رَّبِّ",587105,588045],["ٱلْعَـٰلَمِينَ",588045,591590]],"translation":"[It is] a revelation from the Lord of the worlds."},{"n":81,"from":591810,"to":599880,"words":[["أَفَبِهَـٰذَا",591705,593005],["ٱلْحَدِيثِ",593005,594205],["أَنتُم",594205,595635],["مُّدْهِنُونَ",595635,599680]],"translation":"Then is it to this statement that you are indifferent"},{"n":82,"from":599880,"to":608210,"words":[["وَتَجْعَلُونَ",599785,601265],["رِزْقَكُمْ",601265,602425],["أَنَّكُمْ",602425,604225],["تُكَذِّبُونَ",604225,607990]],"translation":"And make [the thanks for] your provision that you deny [the Provider]?"},{"n":83,"from":608210,"to":615790,"words":[["فَلَوْلَآ",608085,610655],["إِذَا",610655,611325],["بَلَغَتِ",611325,612275],["ٱلْحُلْقُومَ",612275,615560]],"translation":"Then why, when it [i.e., the soul at death] reaches the throat"},{"n":84,"from":615790,"to":625170,"words":[["وَأَنتُمْ",615685,618055],["حِينَئِذٍۢ",618055,619645],["تَنظُرُونَ",619646,624950]],"translation":"And you are at that time looking on -"},{"n":85,"from":625170,"to":634680,"words":[["وَنَحْنُ",625055,625925],["أَقْرَبُ",625925,626825],["إِلَيْهِ",626825,627705],["مِنكُمْ",627705,629565],["وَلَـٰكِن",629565,630495],["لَّا",630495,631065],["تُبْصِرُونَ",631065,634450]],"translation":"And We [i.e., Our angels] are nearer to him than you, but you do not see -"},{"n":86,"from":634680,"to":644530,"words":[["فَلَوْلَآ",634565,637374],["إِن",637374,638695],["كُنتُمْ",638695,640385],["غَيْرَ",640385,641115],["مَدِينِينَ",641115,644350]],"translation":"Then why do you not, if you are not to be recompensed,"},{"n":87,"from":644530,"to":654460,"words":[["تَرْجِعُونَهَآ",644465,647955],["إِن",647955,649105],["كُنتُمْ",649105,650855],["صَـٰدِقِينَ",650855,654320]],"translation":"Bring it back, if you should be truthful?"},{"n":88,"from":654460,"to":664260,"words":[["فَأَمَّآ",654385,657805],["إِن",657805,658985],["كَانَ",658985,659655],["مِنَ",659655,660015],["ٱلْمُقَرَّبِينَ",660015,664120]],"translation":"And if he [i.e., the deceased] was of those brought near [to Allāh],"},{"n":89,"from":664260,"to":673350,"words":[["فَرَوْحٌۭ",664195,665905],["وَرَيْحَانٌۭ",665905,668085],["وَجَنَّتُ",668085,670035],["نَعِيمٍۢ",670035,673240]],"translation":"Then [for him is] rest and bounty and a garden of pleasure."},{"n":90,"from":673350,"to":683590,"words":[["وَأَمَّآ",673305,676915],["إِن",676915,677915],["كَانَ",677915,678505],["مِنْ",678505,679065],["أَصْحَـٰبِ",679065,680135],["ٱلْيَمِينِ",680135,683480]],"translation":"And if he was of the companions of the right,"},{"n":91,"from":683590,"to":690460,"words":[["فَسَلَـٰمٌۭ",683525,684625],["لَّكَ",684625,685365],["مِنْ",685365,685775],["أَصْحَـٰبِ",685775,686845],["ٱلْيَمِينِ",686845,690340]],"translation":"Then [the angels will say], \"Peace for you; [you are] from the companions of the right.\""},{"n":92,"from":690460,"to":704460,"words":[["وَأَمَّآ",690405,693745],["إِن",693745,694875],["كَانَ",694875,695585],["مِنَ",695585,696015],["ٱلْمُكَذِّبِينَ",696015,697815],["ٱلضَّآلِّينَ",697815,704320]],"translation":"But if he was of the deniers [who were] astray,"},{"n":93,"from":704460,"to":710080,"words":[["فَنُزُلٌۭ",704375,705645],["مِّنْ",705645,706795],["حَمِيمٍۢ",706795,709920]],"translation":"Then [for him is] accommodation of scalding water"},{"n":94,"from":710080,"to":714730,"words":[["وَتَصْلِيَةُ",710005,711325],["جَحِيمٍ",711325,714570]],"translation":"And burning in Hellfire."},{"n":95,"from":714730,"to":721780,"words":[["إِنَّ",714645,716095],["هَـٰذَا",716095,717015],["لَهُوَ",717015,717625],["حَقُّ",717625,718355],["ٱلْيَقِينِ",718355,721630]],"translation":"Indeed, this is the true certainty,"},{"n":96,"from":721780,"to":730170,"words":[["فَسَبِّحْ",721715,722775],["بِٱسْمِ",722775,723375],["رَبِّكَ",723375,724345],["ٱلْعَظِيمِ",724345,729880]],"translation":"So exalt the name of your Lord, the Most Great."}]}